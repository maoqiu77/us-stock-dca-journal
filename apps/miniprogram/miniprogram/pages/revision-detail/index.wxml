<view class="container"><view class="title">版本历史</view><view class="subtitle">按最早到最新排列。更正和作废均追加版本，不覆盖旧事实。</view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:for="{{revisions}}" wx:key="revisionId" class="card"><view class="row"><text class="badge">版本 {{index + 1}}</text><text class="muted">{{item.date}} · 顺序 {{item.sequence + 1}}</text></view><view class="row"><text>{{item.symbol}} · {{item.label}}</text><text>{{item.current ? (item.voided ? '当前：已作废' : '当前有效版本') : '历史版本'}}</text></view><view wx:if="{{item.isOpening}}">{{item.quantity}} 股 · 确认总成本 ${{item.totalCost}}</view><view wx:else>{{item.quantity}} 股 × ${{item.price}} · 手续费 ${{item.fee}}</view><view class="muted">记录时间 {{item.recordedAt}}</view><view class="muted">版本号 {{item.revisionId}}<br/>上一个版本 {{item.parentRevision || '无'}}</view><view wx:if="{{item.note}}" class="note">{{item.note}}</view></view></view>
