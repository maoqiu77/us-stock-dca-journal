<view class="container portfolio-page">
  <view class="page-header"><view class="eyebrow">PORTFOLIO</view><view class="title">持仓</view><view class="header-bottom"><view class="portfolio-tagline">记录投资，见证成长</view><view class="actions page-header-actions compact"><button class="secondary small settings-entry" bindtap="showSettings"><image class="button-icon" src="/assets/portfolio/settings-green.png" />设置</button><button class="secondary small record-entry" bindtap="addTrade">＋ 记一笔</button><button class="primary small import-entry" bindtap="addHolding"><image class="button-icon" src="/assets/portfolio/import-white.png" />导入持仓</button></view></view></view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{clockAnomaly}}" class="error"><view class="symbol">设备时间异常，当前数值暂不显示</view><view>最近可靠时点：{{clockAnomaly.asOf}}</view><view>{{clockAnomaly.message}}</view></view>
  <block wx:if="{{view}}">
    <view class="card portfolio-summary">
      <view class="currency-bar"><view class="currency-control"><button class="currency-switch" bindtap="cycleCurrency">{{view.selectedCurrency}} ⇄</button><view class="currency-hint">点此切换市场持仓<view>按 CNY / USD 币种查看</view></view></view><button class="link refresh-quotes" bindtap="refreshMarket" loading="{{marketLoading}}"><image wx:if="{{!marketLoading}}" class="refresh-icon" src="/assets/portfolio/refresh-green.png" />刷新行情</button></view>
      <view class="summary-amount"><image class="summary-decoration" src="/assets/portfolio/decoration.png" aria-hidden="true" /><view class="muted">持有金额{{view.displayAmount.partial ? '（已知部分）' : ''}}</view><view class="big">{{view.displayAmount.value === null ? '--' : (view.selectedCurrency === 'CNY' ? '¥' : '$') + view.displayAmount.value}}</view></view>
      <view class="summary-pnl"><text class="muted">持仓盈亏{{view.displayPnl.partial ? '（已知部分）' : ''}}</text><text class="number">{{view.displayPnlText}}{{view.displayPnlPercent ? ' (' + view.displayPnlPercent + ')' : ''}}</text></view>
      <view wx:if="{{view.displayIncludesScreenshots}}" class="muted summary-note">含截图数据 · 非实时合计</view>
      <view wx:if="{{view.positions.length && (view.displayAmount.covered < view.positions.length || view.displayPnl.covered < view.positions.length)}}" class="muted summary-note">金额 {{view.displayAmount.covered}}/{{view.positions.length}} 项 · 盈亏 {{view.displayPnl.covered}}/{{view.positions.length}} 项</view>
    </view>
    <view class="row section holdings-section"><text>我的持仓</text><button class="link" bindtap="showRecords">交易记录 ›</button></view>
    <scroll-view wx:if="{{view.positions.length}}" class="holdings-scroll" scroll-x="true" show-scrollbar="{{false}}" style="height: {{view.holdingsScrollHeight}}rpx">
      <view class="holdings-track">
        <view class="holdings-table-head"><view class="holding-fixed-head">股票名称</view><view class="metrics-track"><view>市值 / 数量</view><view>现价 / 成本</view><view>持仓盈亏</view><view>今日盈亏</view></view></view>
        <view wx:for="{{view.positions}}" wx:key="id" class="card holding-card">
          <view class="holding-row">
            <view class="holding-fixed" data-symbol="{{item.id}}" bindtap="showPosition"><view class="holding-name">{{item.name || item.symbol}}</view><view class="holding-symbol">{{item.symbol}}</view></view>
            <view class="holding-scroll"><view class="metrics-track">
              <view class="metric-column"><view class="metric-value">{{item.amountText}}</view><view class="metric-sub">{{item.quantityText}}</view></view>
              <view class="metric-column"><view class="metric-value">{{item.currentPriceText}}</view><view class="metric-sub">{{item.unitCostText}}</view></view>
              <view class="metric-column"><view class="metric-value {{item.pnlNegative ? 'loss-text' : 'gain-text'}}">{{item.pnlText}}</view><view class="metric-sub {{item.pnlPercentNegative ? 'loss-text' : 'gain-text'}}">{{item.pnlPercentText}}</view></view>
              <view class="metric-column"><view class="metric-value {{item.dailyPnlNegative ? 'loss-text' : 'gain-text'}}">{{item.dailyPnlText}}</view><view class="metric-sub {{item.dailyPnlPercentNegative ? 'loss-text' : 'gain-text'}}">{{item.dailyPnlPercentText}}</view></view>
            </view></view>
          </view>
          <view wx:if="{{item.checkpointConflict}}" class="error">此前交易记录已变化，请重新校准当前持仓。</view>
        </view>
      </view>
    </scroll-view>
    <view wx:if="{{!view.positions.length}}" class="card empty"><view class="symbol">还没有持仓记录</view><view class="muted">手动添加，或从持仓截图导入。</view><button class="primary" bindtap="addHolding">添加持仓</button></view>
    <button wx:if="{{view.positions.length}}" class="primary analyze-holdings" bindtap="analyzeHoldings"><image class="button-icon" src="/assets/portfolio/bars-white.png" />分析我的持仓<text class="analyze-chevron">›</text></button>
    <view class="muted portfolio-footnote"><text class="info-icon">!</text>成本和真实交易仍按原账本计算；校准当前持仓不会制造买卖流水。</view>
  </block>
</view>

<welcome-dialog />
