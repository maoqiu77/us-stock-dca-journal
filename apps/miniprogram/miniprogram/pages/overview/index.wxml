<view class="container">
  <view class="row"><view><view class="eyebrow">PORTFOLIO</view><view class="title">持仓</view></view><view class="actions"><button class="link" bindtap="showSettings">设置</button><button class="primary small" bindtap="addHolding">＋</button></view></view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{clockAnomaly}}" class="error"><view class="symbol">设备时间异常，当前数值暂不显示</view><view>最近可靠时点：{{clockAnomaly.asOf}}</view><view>{{clockAnomaly.message}}</view></view>
  <block wx:if="{{view}}">
    <view wx:if="{{view.mode === 'demo'}}" class="demo">示例账本 · 全部为虚构数据</view>
    <view class="card hero">
      <view class="row"><picker mode="selector" range="{{view.currencies}}" value="{{currencyIndex}}" bindchange="onCurrency"><view class="picker">{{view.selectedCurrency}}⌄</view></picker><button class="link" bindtap="refreshMarket" loading="{{marketLoading}}">刷新行情</button></view>
      <view class="muted">已记录持仓市值</view><view class="big">{{view.marketValue === null ? '--' : (view.selectedCurrency === 'CNY' ? '¥' : '$') + view.marketValue}}</view>
      <view class="row"><text class="muted">持仓盈亏{{view.unrealizedPnl === null ? '（已知部分不足）' : ''}}</text><text class="number">{{view.unrealizedPnl === null ? '--' : (view.selectedCurrency === 'CNY' ? '¥' : '$') + view.unrealizedPnl}}</text></view>
      <view wx:if="{{view.market.covered < view.market.total}}" class="muted">仅 {{view.market.covered}}/{{view.market.total}} 项有可用价格；未知价格不按 0 计算。</view>
    </view>
    <view class="row section"><text>我的持仓</text><button class="link" bindtap="showRecords">交易记录 ›</button></view>
    <view wx:if="{{!view.positions.length}}" class="card empty"><view class="symbol">还没有持仓记录</view><view class="muted">手动添加，或从持仓截图导入。</view><button class="primary" bindtap="addHolding">添加持仓</button></view>
    <view wx:for="{{view.positions}}" wx:key="id" class="card" data-symbol="{{item.symbol}}" bindtap="showPosition">
      <view class="row"><view><view class="symbol holding-name">{{item.name || item.symbol}}</view><view class="muted">{{item.symbol}} · {{item.market}}<text wx:if="{{item.status === 'unverified'}}"> · 未核实</text></view></view><view class="right"><view class="number">{{item.marketValue === null ? '--' : (item.currency === 'CNY' ? '¥' : '$') + item.marketValue}}</view><view class="muted">{{item.unrealized === null ? '盈亏 --' : (item.currency === 'CNY' ? '¥' : '$') + item.unrealized}}</view></view></view>
      <view wx:if="{{item.checkpointConflict}}" class="error">此前交易记录已变化，请重新校准当前持仓。</view>
    </view>
    <button wx:if="{{view.positions.length}}" class="primary" bindtap="analyzeHoldings">分析我的持仓</button>
    <view class="muted">成本和真实交易仍按原账本计算；校准当前持仓不会制造买卖流水。</view>
  </block>
</view>
