<view class="container">
  <view class="page-header"><view><view class="eyebrow">PORTFOLIO</view><view class="title">持仓</view></view><view class="actions page-header-actions compact"><button class="secondary small settings-entry" bindtap="showSettings">设置</button><button class="primary small" bindtap="addHolding">导入持仓</button></view></view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{clockAnomaly}}" class="error"><view class="symbol">设备时间异常，当前数值暂不显示</view><view>最近可靠时点：{{clockAnomaly.asOf}}</view><view>{{clockAnomaly.message}}</view></view>
  <block wx:if="{{view}}">
    <view wx:if="{{view.mode === 'demo'}}" class="demo">示例账本 · 全部为虚构数据</view>
    <view class="card hero">
      <view class="currency-bar"><view class="currency-control"><picker mode="selector" range="{{view.currencies}}" value="{{currencyIndex}}" bindchange="onCurrency"><view class="currency-switch">{{view.selectedCurrency}} ▾</view></picker><view class="currency-hint">点此切换市场持仓<view>按 CNY / USD 币种查看</view></view></view><button class="link refresh-quotes" bindtap="refreshMarket" loading="{{marketLoading}}">刷新行情</button></view>
      <view class="muted">持有金额{{view.displayAmount.partial ? '（已知部分）' : ''}}</view><view class="big">{{view.displayAmount.value === null ? '--' : (view.selectedCurrency === 'CNY' ? '¥' : '$') + view.displayAmount.value}}</view>
      <view class="row"><text class="muted">持仓盈亏{{view.displayPnl.partial ? '（已知部分）' : ''}}</text><text class="number">{{view.displayPnl.value === null ? '--' : (view.selectedCurrency === 'CNY' ? '¥' : '$') + view.displayPnl.value}}</text></view>
      <view wx:if="{{view.displayIncludesScreenshots}}" class="muted">含截图数据 · 非实时合计</view>
      <view wx:if="{{view.positions.length && (view.displayAmount.covered < view.positions.length || view.displayPnl.covered < view.positions.length)}}" class="muted">金额 {{view.displayAmount.covered}}/{{view.positions.length}} 项 · 盈亏 {{view.displayPnl.covered}}/{{view.positions.length}} 项</view>
    </view>
    <view class="row section"><text>我的持仓</text><button class="link" bindtap="showRecords">交易记录 ›</button></view>
    <view wx:if="{{!view.positions.length}}" class="card empty"><view class="symbol">还没有持仓记录</view><view class="muted">手动添加，或从持仓截图导入。</view><button class="primary" bindtap="addHolding">添加持仓</button></view>
    <view wx:for="{{view.positions}}" wx:key="id" class="card holding-card" data-symbol="{{item.id}}" bindtap="showPosition">
      <view class="row"><view class="holding-identity"><view class="symbol holding-name">{{item.name || item.symbol}}</view><view class="muted">{{item.symbol}} · {{item.market}}</view></view><text class="muted">›</text></view>
      <view class="holding-values"><view><view class="muted">持有金额<text wx:if="{{item.amountFromScreenshot}}" class="snapshot-tag"> · 截图</text></view><view class="number">{{item.amountText}}</view></view><view class="right"><view class="muted">盈亏<text wx:if="{{item.pnlFromScreenshot}}" class="snapshot-tag"> · 截图</text></view><view class="number">{{item.pnlText}}</view></view></view>
      <view wx:if="{{item.checkpointConflict}}" class="error">此前交易记录已变化，请重新校准当前持仓。</view>
    </view>
    <button wx:if="{{view.positions.length}}" class="primary" bindtap="analyzeHoldings">分析我的持仓</button>
    <view class="muted">成本和真实交易仍按原账本计算；校准当前持仓不会制造买卖流水。</view>
  </block>
</view>

<welcome-dialog />
