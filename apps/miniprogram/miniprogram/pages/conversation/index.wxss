.page-heading { margin-bottom: 28rpx; align-items: flex-start; }
.page-heading .title { font-size: 38rpx; overflow-wrap: anywhere; flex: 1; }
.page-heading button { min-width: 64rpx; }
.turn { border-radius: 24rpx; }
.focused { box-shadow: 0 0 0 3rpx #d6a655; }
.question { padding: 8rpx 18rpx 26rpx; }
.question .note { margin-top: 6rpx; }
.assistant { border-top: 5rpx solid #216b50; }
.summary { font-size: 30rpx; line-height: 1.8; margin: 22rpx 0; white-space: pre-wrap; overflow-wrap: anywhere; }
.metric-block { background: #f4f7f2; padding: 22rpx; border-radius: 16rpx; margin-top: 22rpx; }
.metric-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22rpx; margin-bottom: 20rpx; }
.bullet { padding-left: 20rpx; border-left: 3rpx solid #dfe8dc; }
.limitation { background: #fff6e6; padding: 20rpx; border-radius: 14rpx; margin-top: 24rpx; }
.personal-hint { margin-top: 24rpx; padding: 18rpx 0; border-top: 1rpx solid #edf0ea; }
.saved { margin-top: 24rpx; }
.source { padding: 20rpx 0; border-top: 1rpx solid #edf0ea; }
.disclosure { text-align: left; margin-top: 24rpx; }
.suggestions { display: flex; flex-direction: column; gap: 12rpx; margin-bottom: 18rpx; }
.suggestions button { line-height: 1.6; padding: 14rpx 20rpx; text-align: left; }
.note-editor { margin-top: 20rpx; }
.source-overlay { position: fixed; inset: 0; z-index: 20; background: rgba(0,0,0,.35); display: flex; align-items: flex-end; }
.source-sheet { width: 100%; box-sizing: border-box; margin: 0; padding-bottom: calc(30rpx + env(safe-area-inset-bottom)); }
.source-scroll { max-height: 65vh; height: 65vh; }
.technical { overflow-wrap: anywhere; white-space: pre-wrap; margin-top: 24rpx; }
