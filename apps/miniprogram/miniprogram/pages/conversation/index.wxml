<scroll-view class="container" scroll-y scroll-into-view="message-{{focusMessage}}"><view class="eyebrow">ONE CONVERSATION</view><view class="row"><view class="title">同一会话</view><button class="link danger" bindtap="deleteConversation">删除会话</button></view><view class="demo">{{label}}</view><view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:for="{{messages}}" wx:key="id" id="message-{{item.id}}" class="card {{item.role === 'assistant' ? 'assistant' : ''}} {{focusMessage === item.id ? 'focused' : ''}}"><view class="badge">{{item.role === 'assistant' ? (item.execution_kind === 'real' ? '模型生成' : '离线合成 AI') : '我'}}</view><view class="note">{{item.content}}</view><button wx:if="{{item.role === 'assistant'}}" class="link" data-id="{{item.id}}" bindtap="startSaveNote">转存为个人手记</button></view>
  <view wx:if="{{noteMessageId}}" class="card"><view class="symbol">编辑后存为个人手记</view><view class="muted">保存的是你的个人副本，不会改写 AI 原文。</view><textarea value="{{noteDraft}}" maxlength="10000" bindinput="onNoteDraft"/><view class="actions"><button class="secondary" bindtap="cancelSaveNote">取消</button><button class="primary" bindtap="confirmSaveNote">保存副本</button></view></view>
  <view wx:for="{{runs}}" wx:key="id" class="card"><view class="row"><view class="symbol">本轮依据</view><view class="badge">{{item.contextLabel}}</view></view><view class="label">支持证据</view><view wx:for="{{item.evidence}}" wx:for-item="evidence" wx:key="statement" class="note">{{evidence.statement}}</view><view class="label">反面证据</view><view wx:if="{{!item.counterarguments.length}}" class="muted">本轮未提供</view><view wx:for="{{item.counterarguments}}" wx:for-item="counter" wx:key="statement" class="note">{{counter.statement}}</view><view class="label">缺失项</view><view class="muted">{{item.missing.join('、')||'无'}}</view><view wx:for="{{item.sourceDetails}}" wx:for-item="source" wx:key="id" class="source"><view class="badge">{{source.type}}</view><view wx:if="{{source.quote}}" class="note">{{source.quote.symbol}} {{source.quote.price}} · {{source.quote.as_of}} · {{source.quote.provider}}/{{source.quote.feed}}</view><view wx:else class="muted">观察 {{source.as_of}} · 可用 {{source.available_at}} · digest {{source.content_digest}}</view></view></view>
  <view class="card"><textarea value="{{question}}" maxlength="10000" bindinput="onQuestion" placeholder="继续追问"/><view class="actions"><button class="secondary" bindtap="preview">查看本次将使用的信息</button><button wx:if="{{cloud}}" class="primary" loading="{{busy}}" disabled="{{busy || !previewData}}" bindtap="send">发送追问</button></view><view wx:if="{{previewData}}" class="muted">将使用 {{previewData.facts.length}} 项账本信息和 {{previewData.excerpts.length}} 条原文；缺失：{{previewData.missingText}}</view></view>
</scroll-view>
