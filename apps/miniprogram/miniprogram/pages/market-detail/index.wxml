<view class="container" wx:if="{{instrument}}"><view class="eyebrow">{{instrument.exchange}} · {{instrument.asset_type}}</view><view class="title">{{instrument.symbol}}</view><view class="subtitle">{{instrument.name}}</view>
<view class="actions"><button class="secondary" bindtap="toggle">切换自选</button><button class="primary" bindtap="analyze">AI 研究</button></view>
<view class="card"><view class="row"><view><button wx:for="{{ranges}}" wx:key="*this" size="mini" class="{{range===item?'primary':'secondary'}}" data-range="{{item}}" bindtap="setRange">{{item}}</button></view><view><button size="mini" class="{{style==='line'?'primary':'secondary'}}" data-style="line" bindtap="setStyle">收盘线</button><button size="mini" class="{{style==='candle'?'primary':'secondary'}}" data-style="candle" bindtap="setStyle">日 K</button></view></view>
<market-chart wx:if="{{chart.status==='available'}}" bars="{{chart.bars}}" style-mode="{{style}}"/><view wx:else class="empty muted">不会绘制替代曲线。</view><view wx:if="{{chart}}" class="muted">来源 {{chart.provider}}/{{chart.feed}} · {{chart.timezone}} · 未复权日线 · 展示交易日缺口</view></view></view><view wx:if="{{error}}" class="error">{{error}}</view>
