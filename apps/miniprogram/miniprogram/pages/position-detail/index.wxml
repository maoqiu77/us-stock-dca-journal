<view class="container"><view wx:if="{{error}}" class="error">{{error}}</view><block wx:if="{{detail}}"><view class="page-header"><view><view class="title">{{detail.name || detail.symbol}}</view><view class="muted">{{detail.symbol}} · {{detail.currency || 'USD'}}</view></view><view class="actions page-header-actions"><button wx:if="{{!detail.clockAnomaly && detail.currency === 'USD'}}" class="primary small" bindtap="addTrade">记一笔</button><button class="secondary small" bindtap="calibrate">校准</button></view></view>
  <view wx:if="{{detail.clockAnomaly}}" class="error">设备时间异常；以下为截至 {{detail.throughDate}}、记录观察时点 {{detail.knownAt}} 的已保存持仓。校准后可继续记账，设置中仍可导出备份。</view><view class="card"><view class="stats"><view class="stat"><view class="muted">持有数量</view><view class="number">{{detail.quantity}}</view></view><view class="stat"><view class="muted">剩余成本</view><view class="number">{{detail.costText}}</view></view></view><view class="divider"/><view class="row"><text>单位成本</text><text>{{detail.unitCostText}}</text></view><view class="row"><text>持有金额{{detail.amountFromScreenshot ? ' · 截图' : ''}}</text><text>{{detail.holdingAmountText}}</text></view><view class="row"><text>持有盈亏{{detail.pnlFromScreenshot ? ' · 截图' : ''}}</text><text class="number">{{detail.holdingPnlText}}</text></view><view wx:if="{{detail.hasRealized}}" class="row"><text>已实现盈亏</text><text>{{detail.realizedText}}</text></view><quote-card currency="{{detail.currency}}" price="{{detail.marketPrice || ''}}" market-value="{{detail.marketValue || ''}}" unrealized="{{detail.unrealized || ''}}" weight="{{detail.weightExCash || ''}}" as-of="{{detail.quoteAsOf || ''}}" freshness="{{detail.quoteFreshness}}" attribution="{{detail.attribution}}" mapping-status="{{detail.mappingStatus}}"/><view wx:if="{{detail.opening}}" class="note">含期初持仓：{{detail.opening.quantity}} 股，总成本 {{detail.currency === 'CNY' ? '¥' : '$'}}{{detail.opening.totalCost}}</view></view>
<view wx:if="{{detail.screenshotMetrics}}" class="note"><view>截图数据 · 非实时行情</view><view wx:if="{{detail.screenshotMetrics.marketValueText}}">持有金额：{{detail.screenshotMetrics.marketValueText}}</view><view wx:if="{{detail.screenshotMetrics.holdingPnlText}}">持有收益：{{detail.screenshotMetrics.holdingPnlText}}</view><view wx:if="{{detail.screenshotMetrics.holdingReturnRateText}}">持有收益率：{{detail.screenshotMetrics.holdingReturnRateText}}</view><view wx:if="{{detail.screenshotMetrics.dailyChangeRateText}}">日涨幅：{{detail.screenshotMetrics.dailyChangeRateText}}</view><view wx:if="{{detail.screenshotMetrics.navText}}">基金净值 / 参考价：{{detail.screenshotMetrics.navText}}</view><view wx:if="{{detail.screenshotMetrics.navDateText}}">净值日期（按原图）：{{detail.screenshotMetrics.navDateText}}</view><view class="muted">导入时间：{{detail.screenshotImportedAt}}</view></view>
  <view class="section">相关记录与理由</view><view wx:for="{{detail.records}}" wx:key="revisionId" class="card"><view class="row"><text>{{item.date}} · {{item.label}}</text><text>{{item.quantity}} 股</text></view><view wx:if="{{item.note}}" class="note">{{item.note}}</view><view class="actions"><button wx:if="{{!item.voided && !detail.clockAnomaly}}" class="link" data-id="{{item.id}}" data-opening="{{item.isOpening}}" bindtap="editRecord">更正</button><button class="link" data-id="{{item.id}}" bindtap="showHistory">版本历史</button></view></view></block></view>

<welcome-dialog />
