<view class="container"><view wx:if="{{error}}" class="error">{{error}}</view><block wx:if="{{detail}}"><view class="row"><view><view class="title">{{detail.symbol}}</view><view class="badge">{{detail.assetType}}</view></view><view class="actions"><button class="secondary small" bindtap="analyze">AI 投研</button><button wx:if="{{detail.quantity !== '0' && !detail.clockAnomaly}}" class="primary small" bindtap="sell">卖出</button></view></view>
  <view wx:if="{{detail.clockAnomaly}}" class="error">设备时间异常；以下为截至 {{detail.throughDate}}、记录观察时点 {{detail.knownAt}} 的已保存持仓。校准后可继续记账，设置中仍可导出备份。</view><view class="card"><view class="stats"><view class="stat"><view class="muted">持有数量</view><view class="number">{{detail.quantity}}</view></view><view class="stat"><view class="muted">剩余成本</view><view class="number">${{detail.cost}}</view></view></view><view class="divider"/><view class="row"><text>单位成本</text><text>${{detail.unitCost}}</text></view><view class="row"><text>已实现盈亏</text><text>${{detail.realized}}</text></view><view wx:if="{{detail.opening}}" class="note">含期初持仓：{{detail.opening.quantity}} 股，总成本 ${{detail.opening.totalCost}}</view><view class="muted">历史可能不完整 · 现金余额未知</view></view>
  <view class="section">相关记录与理由</view><view wx:for="{{detail.records}}" wx:key="revisionId" class="card"><view class="row"><text>{{item.date}} · {{item.label}}</text><text>{{item.quantity}} 股</text></view><view wx:if="{{item.note}}" class="note">{{item.note}}</view><view class="actions"><button wx:if="{{!item.voided && !detail.clockAnomaly}}" class="link" data-id="{{item.id}}" data-opening="{{item.isOpening}}" bindtap="editRecord">更正</button><button class="link" data-id="{{item.id}}" bindtap="showHistory">版本历史</button></view></view></block></view>
