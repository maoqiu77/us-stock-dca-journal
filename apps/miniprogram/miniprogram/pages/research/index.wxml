<view class="container">
  <view class="row"><view class="title">AI 手记</view><button class="link" bindtap="newConversation">新对话</button></view><view class="subtitle">个人记录保存在本地；只有预览并确认后，所选内容才会发送给云端 AI。</view>
  <view wx:if="{{capability && (!capability.enabled || !capability.providerConfigured || !capability.enrolled)}}" class="demo">{{capability.label}}</view><view wx:if="{{error}}" class="error">{{error}}</view>
  <view class="view-tabs"><button class="{{!historyOpen ? 'primary' : 'secondary'}}" bindtap="showAnalysis">分析</button><button class="{{historyOpen ? 'primary' : 'secondary'}}" bindtap="showRecords">记录</button></view>
  <view wx:if="{{historyOpen}}" class="row record-actions"><text class="muted">按日期回看分析与想法</text><button class="secondary small" bindtap="startNote">记一条</button></view>
  <view wx:if="{{noteOpen}}" class="card"><view class="symbol">个人手记</view><view class="muted">不会自动发送给 AI</view><textarea value="{{noteText}}" maxlength="10000" bindinput="onNote" placeholder="记录今天的观察和决定"/><view class="actions"><button class="secondary" bindtap="cancelNote">取消</button><button class="primary" bindtap="saveNote">保存</button></view></view>
  <view wx:if="{{historyOpen}}" class="card">
    <view class="row calendar-nav"><button class="link" bindtap="previousMonth">上月</button><view class="symbol month-title">{{month}}</view><button class="link" bindtap="nextMonth">下月</button></view>
    <view class="calendar weekdays"><view wx:for="{{weekdays}}" wx:key="*this">{{item}}</view></view>
    <view class="calendar"><view wx:for="{{calendarDays}}" wx:key="id"><button wx:if="{{item.day}}" class="day {{item.hasItems ? 'marked' : ''}} {{selectedDate === item.day ? 'selected' : ''}} {{item.isToday ? 'today' : ''}}" data-day="{{item.day}}" bindtap="selectHistoryDay">{{item.label}}</button></view></view>
    <view class="row calendar-selection"><view class="section">{{selectedDate}}<text class="muted"> · {{historyItems.length}} 条</text></view><button class="link" bindtap="goToday">回到今天</button></view>
    <view wx:if="{{!historyItems.length}}" class="empty muted">这一天还没有记录。可以记下一个想法。</view>
    <view wx:for="{{historyItems}}" wx:key="id" class="history-item">
      <view data-id="{{item.id}}" bindtap="openHistoryItem"><view class="row"><view class="history-title">{{item.title}}</view><text class="muted">{{item.timeLabel}}</text></view><view class="note summary-clamp">{{item.summary}}</view><view wx:if="{{item.conversationId}}" class="row history-footer"><text class="muted">{{item.modelLabel}} · 当天 {{item.turnCount}} 轮问答</text><text class="link-label">继续查看 ›</text></view></view>
      <button wx:if="{{item.kind === 'personal_note'}}" class="link" data-id="{{item.id}}" bindtap="viewNote">查看全文</button><button wx:if="{{item.kind === 'personal_note'}}" class="link danger" data-id="{{item.id}}" bindtap="deleteHistoryItem">删除</button>
    </view>
  </view>
  <block wx:if="{{!historyOpen}}">
  <view class="section">向 AI 提问</view>
  <view class="task-grid"><button class="{{mode === 'portfolio_review' ? 'primary' : 'secondary'}}" bindtap="selectPortfolio">分析我的持仓</button><button class="{{mode === 'instrument_research' ? 'primary' : 'secondary'}}" bindtap="selectInstrument">研究一只股票</button></view>
  <block wx:if="{{mode === 'instrument_research'}}">
    <view class="card"><view class="symbol">分析股票或 ETF</view><view class="market-tabs"><button wx:for="{{markets}}" wx:key="id" class="{{market === item.id ? 'primary' : 'secondary'}}" data-market="{{item.id}}" bindtap="selectMarket">{{item.label}}</button></view>
      <input class="research-search" value="{{symbol}}" maxlength="15" bindinput="onSymbol" placeholder="{{market === 'US' ? '输入股票或 ETF 代码，如 AAPL / QQQ' : market === 'HK' ? '输入五位代码，如 00700 / 02800' : '输入六位代码，如 600519 / 588000'}}"/>
      <view class="instrument-picks"><button wx:for="{{picks}}" wx:key="symbol" class="pick {{symbol === item.symbol ? 'chosen' : ''}}" data-symbol="{{item.symbol}}" bindtap="pickInstrument"><view>{{item.name}}</view><view class="muted">{{item.symbol}}</view></button></view>
    </view>
    <view class="card"><view class="symbol">分析设置</view>
      <view class="period-columns">
        <view><view class="label">主周期</view><view class="muted">选择一个周期</view><view class="periods"><button wx:for="{{periods}}" wx:key="id" class="{{period === item.id ? 'primary' : 'secondary'}}" data-period="{{item.id}}" bindtap="selectPeriod">{{item.label}}</button></view></view>
        <view><view class="label">辅助周期</view><view class="muted">可多选，也可留空</view><view class="periods"><button wx:for="{{auxiliaryOptions}}" wx:key="id" class="{{item.selected ? 'primary' : 'secondary'}}" data-period="{{item.id}}" bindtap="selectAuxiliary">{{item.label}}</button></view></view>
      </view>
      <view class="label">持仓参数 · 选填</view><view class="parameter-grid"><view class="field"><view class="label">持有数量（股 / 份）</view><input type="digit" value="{{quantity}}" data-field="quantity" bindinput="onParameter" placeholder="例如 1000"/></view><view class="field"><view class="label">成本价（{{market === 'US' ? 'USD' : market === 'HK' ? 'HKD' : 'CNY'}}）</view><input type="digit" value="{{costPrice}}" data-field="costPrice" bindinput="onParameter" placeholder="例如 15.50"/></view></view><view class="field"><view class="label">最大持仓（股 / 份）</view><input type="digit" value="{{maxQuantity}}" data-field="maxQuantity" bindinput="onParameter" placeholder="例如 5000"/></view><view class="muted">仅用于本次分析，不修改已记录的持仓。</view>
    </view>
  </block>
  <view wx:else class="card"><view class="field"><view class="label">你想了解什么</view><textarea value="{{question}}" maxlength="10000" bindinput="onQuestion"/></view>
    <checkbox-group class="analysis-selections" bindchange="toggleSelections"><label><checkbox value="includePositions" checked="{{includePositions}}"/>我的持仓</label><label><checkbox value="includePolicy" checked="{{includePolicy}}"/>投资计划</label></checkbox-group>
    <view wx:if="{{includePolicy}}" class="plan-preview"><view class="note">{{planText || '还没有投资计划，可在设置中填写定投安排、目标和风险偏好。'}}</view><button class="link" bindtap="editPlan">{{planText ? '修改投资计划' : '填写投资计划'}}</button></view>
  </view>
  <view class="analysis-actions"><button class="secondary" bindtap="preview" loading="{{marketPreparing}}" disabled="{{busy || marketPreparing}}">{{mode === 'instrument_research' ? '获取行情并预览分析' : '查看本次分析内容'}}</button><button wx:if="{{capability.enabled && capability.providerConfigured && capability.enrolled}}" class="primary" loading="{{busy}}" disabled="{{busy || marketPreparing || !previewData || error}}" bindtap="runCloud">确认并开始分析</button></view>
  <view wx:if="{{previewData}}" class="card"><view class="symbol">本次将使用的信息</view><view wx:for="{{previewData.researchRows}}" wx:key="period" class="series-row"><view>{{item.period}} · {{item.status === 'available' ? item.count + ' 根 K 线' : '暂不可用'}}</view><view class="muted">{{item.provider}} · {{item.status === 'available' ? item.adjustment + ' · ' + item.asOf : item.reason}}</view></view><view wx:for="{{previewData.facts}}" wx:key="id" class="note">{{item.name}}：{{item.value}}</view><view wx:for="{{previewData.excerpts}}" wx:key="id" class="note">选中原文：{{item.text}}</view><view wx:for="{{previewData.marketQuotes}}" wx:key="instrument_key" class="note">行情：{{item.symbol}} {{item.status==='available'?item.price:'不可用'}} · {{item.timeliness}} · {{item.as_of||item.reason}}</view><view wx:if="{{previewData.marketExpiresAt}}" class="muted">已冻结服务端行情凭据，确认有效期至 {{previewData.marketExpiresAt}}。</view><view class="muted">约 {{previewData.approximateCharacters}} 字符 · 缺失：{{previewData.missingText}}</view></view>
  <view class="section">最近会话</view><view wx:if="{{!recent.length}}" class="card empty muted">还没有分析，选一只股票开始吧。</view><view wx:for="{{recent}}" wx:key="id" class="card" data-id="{{item.conversationId}}" bindtap="openConversation"><view class="row"><view class="history-title">{{item.title}}</view><text class="badge">{{item.modelLabel}}</text></view><view class="note summary-clamp">{{item.summary}}</view><view class="row history-footer"><text class="muted">{{item.dateLabel}} · {{item.turnCount}} 轮问答</text><text class="link-label">继续追问 ›</text></view></view>
  </block>
</view>
