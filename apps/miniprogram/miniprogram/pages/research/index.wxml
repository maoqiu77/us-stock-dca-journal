<view class="container">
  <view class="eyebrow">AI RESEARCH</view><view class="title">AI 投研</view><view class="subtitle">先查看本次将使用的信息，再确认开始分析。</view>
  <view class="demo">{{capability.label}}</view><view wx:if="{{error}}" class="error">{{error}}</view>
  <view class="task-grid"><button class="{{mode === 'portfolio_review' ? 'primary' : 'secondary'}}" bindtap="selectPortfolio">分析我的持仓</button><button class="{{mode === 'instrument_research' ? 'primary' : 'secondary'}}" bindtap="selectInstrument">研究一只股票</button></view>
  <view class="card">
    <view wx:if="{{mode === 'instrument_research'}}" class="field"><view class="label">已确认的代码</view><input value="{{symbol}}" maxlength="15" bindinput="onSymbol" placeholder="例如 AAPL"/></view>
    <view class="field"><view class="label">你想了解什么</view><textarea value="{{question}}" maxlength="10000" bindinput="onQuestion"/></view>
    <checkbox-group bindchange="toggleSelections"><label><checkbox value="includeJournal" checked="{{includeJournal}}"/>当日个人记录</label><label><checkbox value="includeTradeReasons" checked="{{includeTradeReasons}}"/>交易理由</label><label><checkbox value="includePolicy" checked="{{includePolicy}}"/>已确认计划</label></checkbox-group>
    <view class="actions"><button class="secondary" bindtap="preview">查看本次分析内容</button><button wx:if="{{capability.realProviderConfigured}}" class="primary" loading="{{busy || marketPreparing}}" disabled="{{busy || marketPreparing || !previewData}}" bindtap="runCloud">确认并开始分析</button></view>
  </view>
  <view wx:if="{{previewData}}" class="card"><view class="symbol">本次将使用的信息</view><view wx:for="{{previewData.facts}}" wx:key="id" class="note">{{item.name}}：{{item.value}}</view><view wx:for="{{previewData.excerpts}}" wx:key="id" class="note">选中原文：{{item.text}}</view><view wx:for="{{previewData.marketQuotes}}" wx:key="instrument_key" class="note">行情：{{item.symbol}} {{item.status==='available'?item.price:'不可用'}} · {{item.timeliness}} · {{item.as_of||item.reason}}</view><view wx:if="{{previewData.marketExpiresAt}}" class="muted">已冻结服务端行情凭据，确认有效期至 {{previewData.marketExpiresAt}}。</view><view class="muted">约 {{previewData.approximateCharacters}} 字符 · 缺失：{{previewData.missingText}}</view></view>
  <view wx:if="{{pending.length}}" class="section">待完成任务</view><view wx:for="{{pending}}" wx:key="requestId" class="card"><view class="note">{{item.question}}</view><view class="muted">{{item.ackPending ? '分析已保存，正在完成同步确认' : '查询原请求的最新状态'}}</view><button class="secondary" data-id="{{item.requestId}}" bindtap="recover">查询原任务</button></view>
  <view class="section">最近分析</view><view wx:if="{{!recent.length}}" class="card empty muted">还没有分析。</view><view wx:for="{{recent}}" wx:key="id" class="card"><view class="row"><text>{{item.date}}</text><text class="badge">{{item.label}}</text></view><view class="note">{{item.summary}}</view><button class="link" data-id="{{item.conversationId}}" bindtap="openConversation">继续追问</button></view>
</view>
