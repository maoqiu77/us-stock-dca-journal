/* Market board */
page { background: #f3fcf8; color: #1b3433; }
.container { padding: 24rpx 26rpx 48rpx; }
.board-header { padding: 10rpx 12rpx 0; }
.board-header .eyebrow { color: #436d61; font-size: 20rpx; letter-spacing: 6rpx; margin: 0 0 8rpx; }
.board-header .title { font-size: 54rpx; font-weight: 700; line-height: 1.2; }
.title-rule { width: 52rpx; height: 8rpx; border-radius: 5rpx; margin-top: 15rpx; background: #43a77a; }
.segments { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12rpx; margin: 26rpx 6rpx 24rpx; }
.segments button { width: 100%; height: 80rpx; line-height: 76rpx; padding: 0 6rpx; border: 2rpx solid #fff; border-radius: 18rpx; font-size: 26rpx; font-weight: 600; white-space: nowrap; box-shadow: 0 8rpx 18rpx #1b654015; }
.segments button.secondary { background: #f8fdfb; color: #234540; }
.segments button.primary { background: #1b7557; color: #fff; }
.board-panel { box-sizing: border-box; padding: 26rpx 24rpx 30rpx; background: #fff; border-radius: 22rpx 22rpx 0 0; box-shadow: 0 8rpx 24rpx #1b65400d; }
.domestic-toolbar { margin: 0 0 16rpx; }
.domestic-toolbar .section { color: #193433; font-size: 33rpx; font-weight: 700; }
.domestic-actions { gap: 12rpx; }
.domestic-actions .refresh-action { display: flex; align-items: center; gap: 8rpx; color: #167554; font-size: 24rpx; }
.refresh-icon { box-sizing: border-box; width: 25rpx; height: 25rpx; border: 3rpx solid #167554; border-right-color: transparent; border-radius: 50%; transform: rotate(-35deg); }
.domestic-actions .domestic-manage { color: #668076; font-size: 22rpx; }
.domestic-search { margin: 0 0 14rpx; }
.search-field { box-sizing: border-box; height: 78rpx; display: flex; align-items: center; gap: 18rpx; padding: 0 22rpx; border: 1rpx solid #dce5ea; border-radius: 14rpx; background: #fbfcfd; color: #788895; }
.search-icon { position: relative; width: 22rpx; height: 22rpx; border: 3rpx solid currentColor; border-radius: 50%; flex: none; }
.search-icon::after { content: ''; position: absolute; width: 12rpx; height: 3rpx; background: currentColor; right: -10rpx; bottom: -5rpx; transform: rotate(48deg); border-radius: 2rpx; }
.search-field input { height: 100%; min-width: 0; flex: 1; padding: 0; margin: 0; border: 0; border-radius: 0; background: transparent; font-size: 25rpx; }
.board-notice { display: flex; align-items: center; gap: 16rpx; padding: 16rpx 18rpx; border-radius: 12rpx; background: #edf8f5; color: #4c6b67; font-size: 21rpx; line-height: 1.5; }
.board-notice text { min-width: 0; flex: 1; overflow-wrap: anywhere; }
.notice-icon { width: 30rpx; height: 30rpx; line-height: 30rpx; flex: none; border-radius: 50%; background: #5f9c86; color: white; text-align: center; font-size: 22rpx; font-weight: 700; }
.board-time { margin: 12rpx 0 18rpx; color: #71818d; font-size: 20rpx; }
.benchmarks { margin-bottom: 20rpx; }
.benchmark { background: #f3f9f6; }
.etf-table { background: transparent; padding: 0; border-radius: 0; }
.etf-head, .etf-line { grid-template-columns: minmax(0, 1.55fr) repeat(3, minmax(0, 1fr)) 18rpx; gap: 8rpx; }
.etf-head { padding: 16rpx 10rpx; color: #70818e; font-size: 20rpx; }
.etf-line { box-sizing: border-box; min-height: 124rpx; padding: 14rpx; margin-bottom: 12rpx; border: 1rpx solid #e3ebed; border-radius: 14rpx; background: #fff; box-shadow: 0 5rpx 14rpx #1b392b0a; font-size: 24rpx; }
.etf-line > view:first-child { min-width: 0; }
.etf-line text { color: #71818d; }
.etf-code { color: #70818e; font-size: 22rpx; }
.etf-name { color: #1d3737; font-size: 24rpx; font-weight: 650; line-height: 1.3; }
.fund-table { background: transparent; padding: 0; }
.fund-head, .fund-line { grid-template-columns: minmax(0, 1.7fr) minmax(0, .9fr) minmax(0, .8fr) 20rpx; gap: 8rpx; }
.fund-head { color: #70818e; font-size: 21rpx; padding: 16rpx 10rpx; }
.fund-line { box-sizing: border-box; min-height: 124rpx; padding: 14rpx 14rpx; margin-bottom: 12rpx; border: 1rpx solid #e3ebed; border-radius: 14rpx; background: #fff; box-shadow: 0 5rpx 14rpx #1b392b0a; }
.fund-line > view:first-child { min-width: 0; }
.fund-line .etf-name { margin-top: 8rpx; }
.fund-line .fund-limit { color: #1d3737; font-size: 24rpx; }
.fund-line .rise { color: #d5203b; font-size: 24rpx; }
.fund-line text { color: #71818d; font-size: 19rpx; }
.fund-chevron { width: 11rpx; height: 11rpx; border-top: 2rpx solid #728592; border-right: 2rpx solid #728592; transform: rotate(45deg); justify-self: center; }
.fund-line .domestic-row-actions { grid-column: 1 / -1; }

