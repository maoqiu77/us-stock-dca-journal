.segments{display:flex;gap:12rpx;flex-wrap:wrap;margin:24rpx 0}.segments button{flex:1;min-width:0;padding:8rpx;font-size:26rpx}.row{gap:20rpx}.row>view:first-child{flex:1;min-width:0;overflow-wrap:anywhere}.muted{overflow-wrap:anywhere}input{background:#f4f6f2;padding:20rpx;border-radius:16rpx;margin-bottom:16rpx}

.market-toolbar{display:flex;align-items:center;gap:16rpx}.market-toolbar .section{flex:1}.market-toolbar button{margin:0}.stock-head,.stock-line{display:flex;align-items:center;gap:12rpx}.stock-head{color:#8a939f;font-size:23rpx;padding:16rpx 0}.stock-head>view:first-child{flex:1}.stock-head>view:nth-child(2){width:142rpx;text-align:right}.stock-head>view:last-child{width:142rpx;text-align:right}.stock-item{padding:30rpx 0;border-bottom:1rpx solid #edf0f3}.stock-identity{display:flex;align-items:center;gap:16rpx;flex:1;min-width:0}.stock-logo{width:66rpx;height:66rpx;flex-shrink:0;border-radius:50%;background:#f3f6f8}.logo-fallback{display:flex;align-items:center;justify-content:center;font-size:18rpx;color:#687785}.stock-label{min-width:0}.stock-name{font-size:29rpx;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.stock-code{font-size:23rpx;color:#9199a1;margin-top:8rpx}.stock-price{width:142rpx;text-align:right;font-size:31rpx;font-weight:600}.stock-change{width:142rpx;text-align:center;font-size:28rpx;font-weight:600;border-radius:8rpx;padding:8rpx 0;background:#edf0f3}.stock-price.up{color:#00af65}.stock-price.down{color:#ed3764}.stock-change.up{background:#00af65;color:white}.stock-change.down{background:#ed3764;color:white}.board-note{font-size:22rpx;margin:24rpx 0}

.etf-table{background:#f4f6f2;border-radius:20rpx;padding:0 14rpx}.etf-head,.etf-line{display:grid;grid-template-columns:minmax(0,1.65fr) repeat(3,minmax(0,1fr));gap:10rpx;align-items:center}.etf-head{font-size:21rpx;color:#6d7a70;padding:20rpx 0}.etf-head>view:not(:first-child),.etf-line>view:not(:first-child){text-align:right}.etf-head text,.etf-line text{display:block;margin-top:8rpx;font-size:21rpx;color:#6d7a70}.etf-line{font-size:25rpx;padding:20rpx 0;border-top:1rpx solid #dce4d9;font-variant-numeric:tabular-nums}.etf-code{color:#6d7a70;font-size:23rpx}.etf-name{font-size:25rpx;font-weight:600;margin-top:8rpx;color:#20372c;overflow-wrap:anywhere}.etf-line .rise,.premium-value{color:#ce373d}.etf-line .fall{color:#21825e}

.benchmarks{display:flex;gap:10rpx}.benchmark{flex:1;min-width:0;background:#f3f8fe;border-radius:16rpx;padding:16rpx 6rpx;text-align:center;font-size:20rpx}.benchmark-name{color:#8194a8;font-weight:600;font-size:23rpx}.benchmark-price{font-size:32rpx;font-weight:700;margin:8rpx 0}.benchmark.rise{color:#ce373d}.benchmark.fall{color:#21825e}

.market-toolbar .section{min-width:100rpx;white-space:nowrap;margin:24rpx 0}.market-toolbar button{flex:none;width:96rpx}.stock-head>view:nth-child(2),.stock-price{width:132rpx}.stock-head>view:last-child,.stock-change{width:128rpx}

.etf-controls{display:flex;gap:12rpx;margin:18rpx 0}.etf-controls button{margin:0;min-width:100rpx;width:auto}.board-time{font-size:21rpx;margin-bottom:18rpx}.etf-cards{background:transparent;padding:0}.etf-cards .etf-line{background:#f4f6f2;border:1rpx solid #dce4d9;border-radius:20rpx;padding:24rpx 16rpx;margin-bottom:18rpx;grid-template-columns:repeat(3,minmax(0,1fr))}.etf-cards .etf-line>view:first-child{grid-column:1 / -1;display:flex;gap:20rpx;align-items:center}.etf-cards .etf-name{margin-top:0}.etf-cards .etf-line>view:not(:first-child){text-align:left}.etf-cards .etf-head{position:static}

.card-metric-label{display:none}.etf-cards .card-metric-label{display:block;color:#6d7a70;font-size:20rpx;margin-bottom:12rpx}

.manage-panel{position:fixed;inset:0;z-index:100;background:#fff;display:flex;flex-direction:column;color:#202624;padding:0 28rpx;box-sizing:border-box}.manage-header{display:flex;align-items:center;justify-content:space-between;height:110rpx;flex-shrink:0;font-size:34rpx;font-weight:600}.manage-header button{margin:0;width:100rpx;padding:0;text-align:left;font-size:30rpx}.manage-header-spacer{width:100rpx}.manage-caption{display:flex;justify-content:space-between;color:#929a97;font-size:24rpx;padding:20rpx 0;border-bottom:1px solid #edf0ee;flex-shrink:0}.manage-scroll{flex:1;min-height:0;height:0}.manage-row{height:88px;box-sizing:border-box;display:flex;align-items:center;gap:24rpx;border-bottom:1px solid #edf0ee;position:relative}.manage-check{width:38rpx;height:38rpx;border:2px solid #929a97;border-radius:50%;flex-shrink:0;text-align:center;line-height:38rpx;color:white}.manage-check.checked{background:#226951;border-color:#226951}.manage-name{flex:1;min-width:0;font-size:32rpx}.manage-name>view{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.manage-name text{display:block;color:#929a97;font-size:26rpx;margin-top:10rpx}.manage-pin{width:70rpx;text-align:center;font-size:48rpx}.drag-handle{height:100%;width:86rpx;display:flex;flex-direction:column;gap:9rpx;justify-content:center;align-items:center;flex-shrink:0}.drag-handle>view{width:38rpx;height:3rpx;background:#666}.manage-row.is-reordering{transition:transform 180ms cubic-bezier(.2,.8,.2,1);will-change:transform}.manage-row.drag-origin{opacity:0}.drop-before:before{content:"";position:absolute;left:0;right:0;top:0;height:3px;background:#226951;z-index:2}.manage-end{height:4px;position:relative}.manage-footer{display:flex;justify-content:space-between;padding:18rpx 0 calc(18rpx + env(safe-area-inset-bottom));border-top:1px solid #edf0ee;flex-shrink:0}.manage-footer button{margin:0;font-size:28rpx}.manage-delete{color:#c84747}.drag-floating{position:fixed;left:28rpx;right:28rpx;height:88px;box-sizing:border-box;display:flex;align-items:center;gap:20rpx;padding:0 26rpx;background:#f1f8f4;border:1px solid #226951;border-radius:14rpx;box-shadow:0 8px 24px #173c3326;pointer-events:none;z-index:110}
