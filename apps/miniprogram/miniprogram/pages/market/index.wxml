<view class="container">
  <view class="board-header"><view class="eyebrow">MARKET</view><view class="title">看板</view><view class="title-rule"></view></view>
  <view class="segments"><button class="{{segment === 'watch' ? 'primary' : 'secondary'}}" data-segment="watch" bindtap="segment">美股</button><button class="{{segment === 'etf' ? 'primary' : 'secondary'}}" data-segment="etf" bindtap="segment">场内 ETF</button><button class="{{segment === 'fund' ? 'primary' : 'secondary'}}" data-segment="fund" bindtap="segment">场外基金</button></view>
  <view wx:if="{{segment !== 'watch'}}" class="board-panel">
    <view wx:if="{{segment === 'etf' && benchmarks.length}}" class="benchmarks"><view wx:for="{{benchmarks}}" wx:key="symbol" class="benchmark {{item.direction}}"><view class="benchmark-name">{{item.name}}</view><view class="benchmark-price">{{item.price || '--'}}</view><view>{{item.changeText}} {{item.percentText}}</view></view></view>
    <view class="domestic-toolbar"><view class="section">{{segment === 'etf' ? '场内 ETF' : '场外基金'}}</view><view class="domestic-actions"><button class="link refresh-action" loading="{{domesticLoading}}" disabled="{{domesticLoading}}" bindtap="refreshDomestic"><view class="refresh-icon"></view>刷新</button><button class="link domestic-manage" bindtap="toggleDomesticManage">{{domesticManaging ? '完成' : '管理'}}</button></view></view>
    <view class="domestic-search"><view class="search-field"><view class="search-icon"></view><input value="{{domesticQuery}}" bindinput="onDomesticQuery" maxlength="80" placeholder="搜索基金名称或代码"/></view><view wx:if="{{domesticSearching}}" class="muted">搜索中…</view><view wx:if="{{domesticSearchError}}" class="error">{{domesticSearchError}}</view><view wx:for="{{domesticResults}}" wx:key="code" class="domestic-result"><view><view>{{item.name}}</view><text>{{item.code}}</text></view><button class="link small" data-code="{{item.code}}" bindtap="addDomestic">添加</button></view></view>
    <view wx:if="{{domesticReason}}" class="board-notice"><view class="notice-icon">i</view><text>{{domesticReason}}</text></view>
    <view wx:if="{{domesticUpdated}}" class="muted board-time">获取于 {{domesticUpdated}} · 行情日 {{domesticDateRange}}</view>
    <view wx:if="{{!domesticRows.length && !domesticLoading}}" class="empty muted">{{domesticReason ? '暂无可核实数据，请稍后刷新。' : '列表为空，可搜索添加基金。'}}</view>
    <view wx:if="{{segment === 'etf'}}" class="etf-table">
      <view class="etf-head"><view data-sort="symbol" bindtap="sortEtf">基金代码 / 名称 ↕</view><view data-sort="changePct" bindtap="sortEtf">日涨幅 ↕<text>当前价</text></view><view data-sort="quotedPremiumPct" bindtap="sortEtf">参考溢价 ↕<text>60日分位</text></view><view data-sort="shares" bindtap="sortEtf">份额(万份) ↕<text>份额增减</text></view><view></view></view>
      <view wx:for="{{domesticRows}}" wx:key="instrument_key" class="etf-line">
        <view data-key="{{item.instrument.instrument_key}}" bindtap="open"><view class="etf-code">{{item.instrument.symbol}}</view><view class="etf-name">{{item.instrument.name}}</view></view>
        <view class="{{item.cnDirection}}" data-key="{{item.instrument.instrument_key}}" bindtap="open"><view>{{item.changeText}}</view><text>¥{{item.valueText}}</text></view>
        <view data-key="{{item.instrument.instrument_key}}" bindtap="open"><view class="{{item.premiumDirection}}">{{item.premiumText}}</view><text>{{item.percentileText}}</text></view>
        <view data-key="{{item.instrument.instrument_key}}" bindtap="open"><view>{{item.sharesText}}</view><text>{{item.sharesChangeText}}</text></view>
        <view wx:if="{{!domesticManaging}}" class="fund-chevron" data-key="{{item.instrument.instrument_key}}" bindtap="open"></view>
        <view wx:if="{{domesticManaging}}" class="domestic-row-actions"><button class="domestic-delete" data-code="{{item.instrument.symbol}}" bindtap="removeDomestic" aria-label="删除 {{item.instrument.name}}">删除</button></view>
      </view>
    </view>
    <view wx:if="{{segment === 'etf'}}" class="muted board-note">点击列标题排序，点击基金查看详情。数据不足时显示 --。</view>
    <view wx:if="{{segment === 'fund'}}" class="fund-table"><view class="fund-head"><view>基金代码 / 名称</view><view data-sort="dailyLimit" bindtap="sortFund">单日限额 {{fundSort === 'dailyLimit' ? (fundAscending ? '↑' : '↓') : '↕'}}</view><view data-sort="changePct" bindtap="sortFund">日涨幅 {{fundSort === 'changePct' ? (fundAscending ? '↑' : '↓') : '↕'}}</view></view><view wx:for="{{domesticRows}}" wx:key="instrument_key" class="fund-line"><view data-key="{{item.instrument.instrument_key}}" bindtap="open"><view class="etf-code">{{item.instrument.symbol}}</view><view class="etf-name">{{item.instrument.name}}</view></view><view class="fund-limit"><view>{{item.limitText}}</view><text>{{item.dailyLimit ? '东方财富参考' : '额度待核实'}}</text></view><view class="{{item.cnDirection}}"><view>{{item.changeText}}</view><text>{{item.navDate || '--'}}</text></view><view wx:if="{{!domesticManaging}}" class="fund-chevron" data-key="{{item.instrument.instrument_key}}" bindtap="open"></view><view wx:if="{{domesticManaging}}" class="domestic-row-actions"><button class="domestic-delete" data-code="{{item.instrument.symbol}}" bindtap="removeDomestic" aria-label="删除 {{item.instrument.name}}">删除</button></view></view></view>
    <view wx:if="{{segment === 'fund'}}" class="muted board-note">单日限额取自东方财富销售页，可能与支付宝等购买渠道不同；购买前以实际平台当日显示为准。</view>
  </view>
  <view hidden="{{segment !== 'watch'}}"><view class="subtitle">自选与持仓分开保存；删除自选不会修改交易记录。</view>
    <view class="card"><input value="{{query}}" bindinput="onQuery" maxlength="80" placeholder="搜索美股名称或代码（至少 2 字符）"/><view wx:if="{{searching}}" class="muted">搜索中…</view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:for="{{results}}" wx:key="instrument_key" class="row"><view bindtap="open" data-key="{{item.instrument_key}}"><view class="symbol">{{item.symbol}} <text class="badge">{{item.asset_type}}</text></view><view class="muted">{{item.name}} · {{item.exchange}}</view></view><button size="mini" class="secondary" data-index="{{index}}" bindtap="add">加自选</button></view></view>
    <view class="market-toolbar"><view class="section">美股</view><button class="link" loading="{{refreshing}}" disabled="{{refreshing}}" bindtap="refresh">刷新</button><button class="link" bindtap="toggleManage">{{managing ? '完成' : '管理'}}</button></view>
    <view class="stock-head"><view>名称 / 代码</view><view>最新价</view><view>涨跌额</view></view>
    <view wx:if="{{!watchlist.length}}" class="card empty muted">列表为空，可搜索添加股票。</view>
    <view wx:for="{{watchlist}}" wx:key="instrument_key" class="stock-item"><view class="stock-line" data-key="{{item.instrument_key}}" bindtap="open"><view class="stock-identity"><image wx:if="{{!item.logoFailed}}" class="stock-logo" src="{{item.logo}}" mode="aspectFit" data-key="{{item.instrument_key}}" binderror="logoError"/><view wx:else class="stock-logo logo-fallback">{{item.symbol}}</view><view class="stock-label"><view class="stock-name">{{item.name}}</view><view class="stock-code">{{item.symbol}}.US</view></view></view><view class="stock-price {{item.direction}}">{{item.priceText}}</view><view class="stock-change {{item.direction}}">{{item.changeAmountText}}</view></view></view>
    <view class="muted board-note">USD · 常用标的初始列表，可自由管理；行情来源、时间与状态见详情。无数据时显示 --。</view>
  </view>
</view>
<view wx:if="{{managing}}" class="manage-panel">
  <view class="manage-header"><button class="link" bindtap="closeManage">完成</button><view>股票管理</view><view class="manage-header-spacer"></view></view>
  <view class="manage-caption"><text>名称 / 代码</text><text>按住右侧拖动排序</text></view>
  <scroll-view class="manage-scroll" scroll-y="{{!dragKey}}" scroll-top="{{manageScroll}}" bindscroll="manageScrolled" enhanced="{{true}}" show-scrollbar="{{false}}">
    <view wx:for="{{watchlist}}" wx:key="instrument_key" class="manage-row {{dragKey ? 'is-reordering' : ''}} {{dragKey === item.instrument_key ? 'drag-origin' : ''}}" style="transform:translateY({{dragOffsets[index] || 0}}px)"><view class="manage-check {{item.manageSelected ? 'checked' : ''}}" data-key="{{item.instrument_key}}" bindtap="selectManaged">{{item.manageSelected ? '✓' : ''}}</view><view class="manage-name"><view>{{item.name}}</view><text>{{item.symbol}}.US</text></view><view class="manage-pin" data-key="{{item.instrument_key}}" bindtap="pinManaged">{{index ? '↥' : ''}}</view><view class="drag-handle" data-key="{{item.instrument_key}}" catchtouchstart="startDrag" catchtouchmove="moveDrag" catchtouchend="endDrag" catchtouchcancel="cancelDrag"><view></view><view></view><view></view></view></view>
    <view class="manage-end"></view><view wx:if="{{!watchlist.length}}" class="empty muted">列表为空，完成后可搜索添加。</view>
  </scroll-view>
  <view class="manage-footer"><button class="link" bindtap="selectAllManaged">{{manageSelected.length === watchlist.length && watchlist.length ? '取消全选' : '全选'}}</button><button class="link manage-delete" disabled="{{!manageSelected.length}}" bindtap="deleteManaged">删除（{{manageSelected.length}}）</button></view>
  <view wx:if="{{dragItem}}" class="drag-floating" style="top:{{dragTop}}px"><view class="manage-name"><view>{{dragItem.name}}</view><text>{{dragItem.symbol}}.US</text></view><text>☰</text></view>
</view>
<welcome-dialog />
