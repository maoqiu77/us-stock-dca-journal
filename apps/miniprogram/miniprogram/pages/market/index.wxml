<view class="container"><view class="eyebrow">MARKET</view><view class="title">看板</view><view class="segments"><button class="secondary" data-segment="watch" bindtap="segment">美股</button><button class="secondary" data-segment="etf" bindtap="segment">场内 ETF</button><button class="secondary" data-segment="fund" bindtap="segment">场外基金</button></view><view wx:if="{{segment !== 'watch'}}"><view wx:if="{{segment === 'etf' && benchmarks.length}}" class="benchmarks"><view wx:for="{{benchmarks}}" wx:key="symbol" class="benchmark {{item.direction}}"><view class="benchmark-name">{{item.name}}</view><view class="benchmark-price">{{item.price || '--'}}</view><view>{{item.changeText}} {{item.percentText}}</view></view></view><view class="card"><view class="symbol">{{segment === 'etf' ? '国内场内纳指 / 标普 ETF' : '场外 QDII 基金'}}</view><view class="muted">{{domesticReason}}</view><button class="link" loading="{{domesticLoading}}" disabled="{{domesticLoading}}" bindtap="refreshDomestic">刷新</button><view wx:if="{{!domesticRows.length && !domesticLoading}}" class="empty muted">暂无可核实数据</view></view><view wx:if="{{segment === 'etf'}}" class="etf-controls"><button class="{{etfLayout === 'list' ? 'primary' : 'secondary'}} small" data-layout="list" bindtap="changeEtfLayout">列表</button><button class="{{etfLayout === 'cards' ? 'primary' : 'secondary'}} small" data-layout="cards" bindtap="changeEtfLayout">卡片</button></view><view wx:if="{{domesticUpdated}}" class="muted board-time">获取于 {{domesticUpdated}} · 行情日 {{domesticDateRange}}</view><view wx:if="{{segment === 'etf'}}" class="etf-table {{etfLayout === 'cards' ? 'etf-cards' : ''}}"><view class="etf-head"><view data-sort="symbol" bindtap="sortEtf">基金代码 / 名称 ↕</view><view data-sort="changePct" bindtap="sortEtf">日涨幅 ↕<text>当前价</text></view><view data-sort="quotedPremiumPct" bindtap="sortEtf">参考溢价 ↕<text>60日分位</text></view><view data-sort="shares" bindtap="sortEtf">份额(万份) ↕<text>份额增减</text></view></view><view wx:for="{{domesticRows}}" wx:key="instrument_key" class="etf-line" data-key="{{item.instrument.instrument_key}}" bindtap="open"><view><view class="etf-code">{{item.instrument.symbol}}</view><view class="etf-name">{{item.instrument.name}}</view></view><view class="{{item.cnDirection}}"><view class="card-metric-label">涨幅 / 现价</view><view>{{item.changeText}}</view><text>¥{{item.valueText}}</text></view><view><view class="card-metric-label">溢价 / 60日分位</view><view class="{{item.premiumDirection}}">{{item.premiumText}}</view><text>{{item.percentileText}}</text></view><view><view class="card-metric-label">万份 / 增减</view><view>{{item.sharesText}}</view><text>{{item.sharesChangeText}}</text></view></view><view class="muted board-note">点击列标题排序，点击基金查看详情。60日分位需完整历史样本，份额增减需相邻交易日数据；不足时显示 --。</view></view><view wx:if="{{segment === 'fund'}}" wx:for="{{domesticRows}}" wx:key="instrument_key" class="card" data-key="{{item.instrument.instrument_key}}" bindtap="open"><view class="symbol">{{item.instrument.name}}</view><view class="muted">{{item.instrument.symbol}} · {{item.instrument.exchange}}</view><view>{{segment === 'etf' ? '参考价格' : '单位净值'}} {{item.valueText}} CNY</view><view wx:if="{{segment === 'etf'}}" class="muted">{{item.tradeDate || '--'}} · 涨跌 {{item.changeText}}<view>{{item.premiumLabel}} {{item.premiumText}}</view></view><view class="muted">净值 {{item.nav || '--'}} · 净值日 {{item.navDate || '--'}} · 公告日 {{item.announcementDate || '--'}}</view><view class="muted">{{item.source}} · 获取 {{item.fetchedAt}}</view></view></view><view hidden="{{segment !== 'watch'}}"><view class="subtitle">自选与持仓分开保存；删除自选不会修改交易记录。</view>
<view class="card"><input value="{{query}}" bindinput="onQuery" maxlength="80" placeholder="搜索美股名称或代码（至少 2 字符）"/><view wx:if="{{searching}}" class="muted">搜索中…</view><view wx:if="{{error}}" class="error">{{error}}</view>
<view wx:for="{{results}}" wx:key="instrument_key" class="row"><view bindtap="open" data-key="{{item.instrument_key}}"><view class="symbol">{{item.symbol}} <text class="badge">{{item.asset_type}}</text></view><view class="muted">{{item.name}} · {{item.exchange}}</view></view><button size="mini" class="secondary" data-index="{{index}}" bindtap="add">加自选</button></view></view>
<view class="market-toolbar"><view class="section">美股</view><button class="link" loading="{{refreshing}}" disabled="{{refreshing}}" bindtap="refresh">刷新</button><button class="link" bindtap="toggleManage">{{managing ? '完成' : '管理'}}</button></view>
<view class="stock-head"><view>名称 / 代码</view><view>最新价</view><view>涨跌额</view></view>
<view wx:if="{{!watchlist.length}}" class="card empty muted">列表为空，可搜索添加股票。</view>
<view wx:for="{{watchlist}}" wx:key="instrument_key" class="stock-item">
<view class="stock-line" data-key="{{item.instrument_key}}" bindtap="open"><view class="stock-identity"><image wx:if="{{!item.logoFailed}}" class="stock-logo" src="{{item.logo}}" mode="aspectFit" data-key="{{item.instrument_key}}" binderror="logoError"/><view wx:else class="stock-logo logo-fallback">{{item.symbol}}</view><view class="stock-label"><view class="stock-name">{{item.name}}</view><view class="stock-code">{{item.symbol}}.US</view></view></view><view class="stock-price {{item.direction}}">{{item.priceText}}</view><view class="stock-change {{item.direction}}">{{item.changeAmountText}}</view></view>

</view><view class="muted board-note">USD · 常用标的初始列表，可自由管理；行情来源、时间与状态见详情。无数据时显示 --。</view></view></view>

<view wx:if="{{managing}}" class="manage-panel">
  <view class="manage-header"><button class="link" bindtap="closeManage">完成</button><view>股票管理</view><view class="manage-header-spacer"></view></view>
  <view class="manage-caption"><text>名称 / 代码</text><text>按住右侧拖动排序</text></view>
  <scroll-view class="manage-scroll" scroll-y="{{!dragKey}}" scroll-top="{{manageScroll}}" bindscroll="manageScrolled" enhanced="{{true}}" show-scrollbar="{{false}}">
    <view wx:for="{{watchlist}}" wx:key="instrument_key" class="manage-row {{dragKey ? 'is-reordering' : ''}} {{dragKey === item.instrument_key ? 'drag-origin' : ''}}" style="transform:translateY({{dragOffsets[index] || 0}}px)">
      <view class="manage-check {{item.manageSelected ? 'checked' : ''}}" data-key="{{item.instrument_key}}" bindtap="selectManaged">{{item.manageSelected ? '✓' : ''}}</view>
      <view class="manage-name"><view>{{item.name}}</view><text>{{item.symbol}}.US</text></view>
      <view class="manage-pin" data-key="{{item.instrument_key}}" bindtap="pinManaged">{{index ? '↥' : ''}}</view>
      <view class="drag-handle" data-key="{{item.instrument_key}}" catchtouchstart="startDrag" catchtouchmove="moveDrag" catchtouchend="endDrag" catchtouchcancel="cancelDrag"><view></view><view></view><view></view></view>
    </view>
    <view class="manage-end"></view>
    <view wx:if="{{!watchlist.length}}" class="empty muted">列表为空，完成后可搜索添加。</view>
  </scroll-view>
  <view class="manage-footer"><button class="link" bindtap="selectAllManaged">{{manageSelected.length === watchlist.length && watchlist.length ? '取消全选' : '全选'}}</button><button class="link manage-delete" disabled="{{!manageSelected.length}}" bindtap="deleteManaged">删除（{{manageSelected.length}}）</button></view>
  <view wx:if="{{dragItem}}" class="drag-floating" style="top:{{dragTop}}px"><view class="manage-name"><view>{{dragItem.name}}</view><text>{{dragItem.symbol}}.US</text></view><text>☰</text></view>
</view>

<welcome-dialog />
