<view class="container">
  <view class="title">{{stage === 'review' ? '核对持仓' : '截图导入'}}</view>
  <view class="subtitle">选截图 → 点开每项核对数量、金额和成本 → 确认导入。截图原文会保留。</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{!capability.enabled || !capability.providerConfigured}}" class="note">截图识别暂不可用，已有草稿仍可核对。</view>
  <view wx:if="{{stage === 'select'}}" class="card">
    <view class="image-grid"><image wx:for="{{images}}" wx:key="path" class="preview-image" src="{{item.path}}" mode="aspectFit"/></view>
    <view class="note">支持多张截图。请遮挡姓名、账号；识别时将发送至云端。</view>
    <button wx:if="{{!images.length}}" class="primary" disabled="{{busy}}" bindtap="chooseImage">选择截图</button>
    <block wx:else><button class="primary" loading="{{busy}}" disabled="{{busy || !capability.enabled || !capability.providerConfigured}}" bindtap="startRecognition">开始识别</button><view class="link" bindtap="chooseImage">重新选择</view></block>
  </view>
  <view wx:if="{{progress}}" class="note">{{progress}}</view>
  <view wx:for="{{failedImages}}" wx:key="number" class="error">第 {{item.number}} 张：{{item.message}}</view>
  <button wx:if="{{failedImages.length}}" class="secondary" disabled="{{busy}}" bindtap="startRecognition">重试失败图片</button>
  <block wx:if="{{stage === 'review'}}">
    <view class="row section"><text>{{rows.length}} 项 · 已选 {{selectedCount}} 项</text><text class="link" bindtap="chooseImage">重新选图</text></view>
    <view wx:for="{{documents}}" wx:key="number" class="note">
      第 {{item.number}} 张 · {{item.platform || '截图'}}
      <view wx:if="{{item.pageType && item.pageType !== 'holdings'}}">{{item.pageType === 'watchlist' ? '这是自选列表，请换一张持仓截图。' : '未识别为持仓页面，请补充持仓截图。'}}</view>
      <view wx:if="{{item.coverage === 'partial' || item.truncated}}">仅导入截图可见项目，不影响其他持仓。</view>
      <view wx:if="{{item.accountType === 'margin'}}">信用账户：负债和保证金仅保留原文，不计入持仓合计。</view>
    </view>
    <view wx:for="{{rows}}" wx:key="rowId" class="card">
      <view class="row" data-index="{{index}}" bindtap="toggleEdit"><view class="symbol">{{item.name || '名称待补充'}}</view><text class="muted">{{item.editing ? '收起' : '›'}}</text></view>
      <view data-index="{{index}}" bindtap="toggleEdit">
        <view class="row"><text class="muted">{{item.symbol}} · 数量 {{item.quantity || '待核对'}}</text><text class="link">{{item.editing ? '收起详情' : '点此核对 ›'}}</text></view>
        <view class="row"><text class="muted">持有金额 · {{item.currency || '币种待补充'}}</text><text>{{item.screenshotMetrics.marketValueText || '未显示'}}</text></view>
        <view class="row"><text class="muted">持有盈亏 · 截图</text><text>{{item.screenshotMetrics.holdingPnlText || '未显示'}}</text></view>
        <view wx:for="{{item.issues}}" wx:for-item="issue" wx:key="*this" class="compact-error">{{issue}} · 点此查看</view>
      </view>
      <view wx:if="{{item.duplicate}}" class="note">重复项目，请仅选择一项。</view>
      <view wx:if="{{!item.unsupported}}" class="select-state" data-index="{{index}}" bindtap="toggleRow">{{item.selected ? '☑ 本次导入' : '□ 本次不导入'}}</view>
      <block wx:if="{{item.editing}}">
        <view class="muted">第 {{item.sourceImage}} 张 · {{item.symbol}} · {{item.quantity || '数量未显示'}}</view>
        <block wx:if="{{!item.unsupported}}">
          <view class="field"><view class="label">名称</view><input value="{{item.name}}" data-index="{{index}}" data-field="name" bindinput="onRowField"/></view>
          <view class="field"><view class="label">代码</view><input value="{{item.symbol}}" data-index="{{index}}" data-field="symbol" bindinput="onRowField" placeholder="请确认代码"/></view>
          <view wx:if="{{item.candidates.length}}" class="candidate-list"><view class="label">匹配结果，点选正确的一项</view><button wx:for="{{item.candidates}}" wx:for-item="candidate" wx:for-index="candidateIndex" wx:key="instrument_key" class="secondary small" data-index="{{index}}" data-candidate="{{candidateIndex}}" bindtap="pickCandidate">{{candidate.name}} · {{candidate.symbol}} · {{candidate.market}}</button></view>
          <button wx:if="{{item.issues.length && item.name && item.symbol && item.market && item.currency && !item.candidates.length}}" class="secondary small" data-index="{{index}}" bindtap="confirmManual">我已核对，使用此标的</button>
          <view class="row compact"><view class="field half"><view class="label">持有数量 / 份额</view><input value="{{item.quantity}}" data-index="{{index}}" data-field="quantity" bindinput="onRowField"/></view><view class="field half"><view class="label">平均成本（可不填）</view><input value="{{item.unitCost}}" data-index="{{index}}" data-field="unitCost" bindinput="onRowField" placeholder="未知"/></view></view>
          <view wx:if="{{item.estimatedCostText}}" class="note">{{item.estimatedCostText}}</view>
          <view class="row compact"><view class="field half"><view class="label">市场</view><input value="{{item.market}}" data-index="{{index}}" data-field="market" bindinput="onRowField"/></view><view class="field half"><view class="label">币种</view><input value="{{item.currency}}" data-index="{{index}}" data-field="currency" bindinput="onRowField"/></view></view>
          <view class="type-row"><text class="link" data-index="{{index}}" data-type="STOCK" bindtap="setAssetType">{{item.assetType === 'STOCK' ? '●' : '○'}} 股票</text><text class="link" data-index="{{index}}" data-type="ETF" bindtap="setAssetType">{{item.assetType === 'ETF' ? '●' : '○'}} ETF</text><text class="link" data-index="{{index}}" data-type="FUND" bindtap="setAssetType">{{item.assetType === 'FUND' ? '●' : '○'}} 基金</text></view>
          <view class="label">核对截图数据（可改，留空表示未知）</view>
          <view class="field"><view class="label">持有金额 · {{item.currency}}</view><input value="{{item.screenshotMetrics.marketValueText}}" data-index="{{index}}" data-field="marketValueText" bindinput="onMetric"/></view>
          <view class="field"><view class="label">持有盈亏 · {{item.currency}}</view><input value="{{item.screenshotMetrics.holdingPnlText}}" data-index="{{index}}" data-field="holdingPnlText" bindinput="onMetric"/></view>
          <view class="row compact"><view class="field half"><view class="label">持有收益率</view><input value="{{item.screenshotMetrics.holdingReturnRateText}}" data-index="{{index}}" data-field="holdingReturnRateText" bindinput="onMetric"/></view><view class="field half"><view class="label">日涨幅</view><input value="{{item.screenshotMetrics.dailyChangeRateText}}" data-index="{{index}}" data-field="dailyChangeRateText" bindinput="onMetric"/></view></view>
          <view wx:if="{{item.assetType === 'FUND'}}" class="field"><view class="label">基金净值</view><input value="{{item.screenshotMetrics.navText}}" data-index="{{index}}" data-field="navText" bindinput="onMetric"/></view>
        </block>
        <view class="label">截图原始信息</view>
        <view wx:for="{{item.screenshotMetrics.originalFields}}" wx:for-item="field" wx:key="index" class="row"><text>{{field.label}}</text><text>{{field.value}} {{field.unit || ''}}</text></view>
        <view wx:for="{{item.observationIssues}}" wx:key="*this" class="note">{{item}}</view>
        <view wx:if="{{item.existing}}" class="note">已有数量 {{item.existing.quantity}} → {{item.quantity || '--'}}，最终确认后更新。</view>
      </block>
    </view>
    <view wx:if="{{documents.length}}" class="link" bindtap="toggleDocuments">{{showDocuments ? '收起账户原始信息' : '账户原始信息 ›'}}</view>
    <block wx:if="{{showDocuments}}"><view wx:for="{{documents}}" wx:key="number" class="card"><view>第 {{item.number}} 张 · {{item.currency}}</view><view wx:for="{{item.fields}}" wx:for-item="field" wx:key="index">{{field.label}}：{{field.value}} {{field.unit || ''}}</view><view wx:for="{{item.groups}}" wx:for-item="group" wx:key="index"><view>{{group.label}} · {{group.currency}}</view><view wx:for="{{group.fields}}" wx:for-item="field" wx:key="index">{{field.label}}：{{field.value}}</view></view></view></block>
    <view class="sticky-actions"><button class="primary" loading="{{busy}}" disabled="{{busy || !selectedCount}}" bindtap="preview">确认导入 {{selectedCount}} 项</button></view>
    <view class="muted">未完成的内容自动保存为本地草稿。</view>
  </block>
</view>
<welcome-dialog />
