.title,.muted{overflow-wrap:anywhere}.actions{display:flex;flex-wrap:wrap;gap:16rpx}.actions button{min-width:0;white-space:normal;font-size:28rpx}.price{font-size:68rpx;font-weight:650;line-height:1.2}.change{font-size:28rpx;margin:12rpx 0 18rpx}.up{color:#17674d}.down{color:#b33a3a}.flat{color:#526057}.chart-heading,.date-axis{display:flex;justify-content:space-between;align-items:center}.section-label{font-size:28rpx;font-weight:600}.ranges{display:flex;gap:8rpx}.range{padding:8rpx 18rpx;font-size:24rpx;border-radius:12rpx;color:#6a766e}.range.active{background:#e8f0eb;color:#17674d}.averages{display:flex;flex-wrap:wrap;gap:18rpx;font-size:21rpx;margin-top:24rpx}.ma5{color:#c28b35}.ma20{color:#328ba0}.ma60{color:#9b65b6}.date-axis,.chart-note,.source,.metric-note{font-size:22rpx;color:#7a847d}.chart-note{margin-top:18rpx;line-height:1.6}.metrics{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:28rpx 20rpx;margin-top:28rpx}.metric-value{font-size:30rpx;font-weight:550;margin-top:8rpx}.metric-note{margin-top:6rpx;overflow-wrap:anywhere}.source{line-height:1.7;margin:24rpx 8rpx}.empty-chart{text-align:center;padding:100rpx 0;color:#7a847d;font-size:26rpx}
