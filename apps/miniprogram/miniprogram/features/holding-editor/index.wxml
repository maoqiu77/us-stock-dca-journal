<view class="container">
  <view class="title">{{existing ? '校准当前持仓' : '添加持仓'}}</view>
  <view class="subtitle">只确认现在实际持有的数量，不补造历史买入或现金流。</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view class="card">
    <view class="field"><label class="label">名称</label><input value="{{name}}" data-field="name" bindinput="onField" placeholder="例如 纳斯达克 100 ETF"/></view>
    <view class="field"><label class="label">代码</label><input value="{{symbol}}" data-field="symbol" bindinput="onField" placeholder="例如 QQQ、510300"/><button class="secondary" loading="{{searching}}" bindtap="searchAsset">搜索标的</button><view wx:for="{{candidates}}" wx:key="instrument_key" class="note" data-index="{{index}}" bindtap="pickAsset">{{item.name}} · {{item.symbol}} · {{item.currency}}</view></view>
    <view class="field"><view class="label">资产类型</view><view class="choice"><button class="{{assetType === 'ETF' ? 'primary' : 'secondary'}}" data-type="ETF" bindtap="onType">ETF</button><button class="{{assetType === 'STOCK' ? 'primary' : 'secondary'}}" data-type="STOCK" bindtap="onType">股票</button><button class="{{assetType === 'FUND' ? 'primary' : 'secondary'}}" data-type="FUND" bindtap="onType">基金</button></view></view>
    <view class="field"><view class="label">币种</view><picker mode="selector" range="{{currencyOptions}}" value="{{currencyIndex}}" bindchange="onCurrency"><view class="picker">{{currency}}<text>⌄</text></view></picker></view>
    <view class="field"><label class="label">数量 / 份额</label><input type="digit" value="{{quantity}}" data-field="quantity" bindinput="onField"/></view>
    <view class="paired-fields">
      <view class="field half"><label class="label">持仓成本价</label><input type="digit" value="{{unitCost}}" data-field="unitCost" bindinput="onField" placeholder="可选"/></view>
      <view class="field half"><view class="label">持仓盈亏</view><view class="pnl-input"><picker mode="selector" range="{{pnlModes}}" value="{{pnlModeIndex}}" bindchange="onPnlMode"><view class="pnl-mode">{{pnlMode === 'profit' ? '盈利' : '亏损'}}<text>⌄</text></view></picker><input type="digit" value="{{pnlPercent}}" data-field="pnlPercent" bindinput="onField" placeholder="%"/></view></view>
    </view>
    <view class="price-hint">当前价 {{marketPrice ? (currency === 'CNY' ? '¥' : '$') + marketPrice : '暂不可用'}} · 成本价和盈亏比可任选一项填写，另一项会自动换算。</view>
    <view wx:if="{{costSuggestion && !unitCost && quantity === costSuggestion.quantity && symbol === existing.symbol && market === existing.market && currency === existing.currency && assetType === existing.assetType}}" class="cost-suggestion"><view>截图持有金额 {{currency === 'CNY' ? '¥' : '$'}}{{costSuggestion.marketValue}} − 持有盈亏 {{currency === 'CNY' ? '¥' : '$'}}{{costSuggestion.holdingPnl}} = 估算总成本 {{currency === 'CNY' ? '¥' : '$'}}{{costSuggestion.totalCost}}</view><view class="muted">按截图的 {{costSuggestion.quantity}} {{assetType === 'FUND' ? '份' : '股'}}计算，单位成本约 {{costSuggestion.unitCost}}。请核对截图时点及数据。</view><button class="secondary small" disabled="{{saving || pendingSave}}" bindtap="fillCost">填入估算成本</button></view>
    <view wx:if="{{existing}}" class="note">当前数量 {{existing.quantity}} → {{quantity || '--'}}。校准会保留全部历史交易，但校准前收益可能不再完整。</view>
    <button class="secondary" disabled="{{saving || pendingSave}}" bindtap="preview">检查</button>
  </view>
  <view wx:if="{{previewData}}" class="card"><view class="symbol">保存前核对</view><view class="row"><text>当前数量</text><text>{{previewData.before.quantity}} → {{previewData.after.quantity}}</text></view><view class="row"><text>成本价</text><text>{{previewData.before.unitCost === null ? '未知' : previewData.before.unitCost}} → {{previewData.after.unitCost === null ? '未知' : previewData.after.unitCost}}</text></view><view class="muted">写入类型：持仓校准（非交易）</view><button class="primary" loading="{{saving}}" disabled="{{saving || pendingSave}}" bindtap="submit">确认保存</button></view>
  <button wx:if="{{existing}}" class="delete-holding" disabled="{{saving || pendingSave}}" bindtap="deleteHolding">删除持仓</button>
</view>

<welcome-dialog />
