page { background: #f1f7f3; }
.conversation-page { padding: 24rpx 24rpx calc(36rpx + env(safe-area-inset-bottom)); background: linear-gradient(145deg, #f4faf6, #eff6f2 60%, #f7fbf8); color: #123a30; }
.page-heading { margin-bottom: 28rpx; align-items: flex-start; }
.page-heading .title { font-size: 36rpx; overflow-wrap: anywhere; flex: 1; }
.page-heading button { min-width: 64rpx; color: #2a6550; }
.turn { border-radius: 26rpx; }
.focused { box-shadow: 0 0 0 3rpx #d6a655; }
.question { padding: 8rpx 18rpx 26rpx; }
.question .note { margin-top: 6rpx; }
.conversation-page .card { border: 1rpx solid #e8f0eb; border-radius: 26rpx; padding: 28rpx; background: #fff; box-shadow: 0 8rpx 28rpx #244c3610; margin-bottom: 24rpx; }
.assistant .muted { color: #748087; font-size: 23rpx; line-height: 1.8; }
.assistant .note { color: #546169; font-size: 26rpx; line-height: 1.85; overflow-wrap: anywhere; }
.summary { color: #43575a; font-size: 28rpx; line-height: 1.85; margin: 24rpx 0; white-space: pre-wrap; overflow-wrap: anywhere; }
.assistant .section { position: relative; padding-left: 24rpx; margin: 30rpx 0 20rpx; color: #123b2f; font-size: 32rpx; font-weight: 650; }
.assistant .section::before { content: ''; position: absolute; left: 0; top: 7rpx; bottom: 7rpx; width: 7rpx; border-radius: 4rpx; background: linear-gradient(#70ae8a, #3c906b); }
.metric-block { background: #f2f7f3; padding: 22rpx; border-radius: 18rpx; margin-top: 22rpx; }
.metric-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22rpx; margin-bottom: 20rpx; }
.metric-grid > view { min-width: 0; overflow-wrap: anywhere; }
.bullet { padding: 12rpx 20rpx 12rpx 24rpx; border-left: 5rpx solid #a4cfb3; border-radius: 5rpx 14rpx 14rpx 5rpx; background: #f7faf8; }
.assistant .badge { background: #eaf4ed; color: #357355; border-radius: 28rpx; padding: 6rpx 16rpx; font-size: 22rpx; font-weight: 550; }
.assistant .observation { margin-top: 20rpx; }
.assistant .observation-badge { display: inline-flex; max-width: 100%; box-sizing: border-box; align-items: center; gap: 10rpx; margin-bottom: 6rpx; line-height: 1.6; white-space: normal; }
.inline-icon { width: 26rpx; height: 26rpx; flex-shrink: 0; vertical-align: middle; }
.limitation { background: linear-gradient(120deg, #fffaf0, #fcf9f0); border: 1rpx solid #f6e7bc; padding: 22rpx; border-radius: 18rpx; margin-top: 26rpx; }
.limitation-heading { display: flex; align-items: center; gap: 16rpx; font-size: 28rpx; font-weight: 650; margin-bottom: 14rpx; color: #163d31; }
.warning-icon { display: flex; align-items: center; justify-content: center; flex: none; border-radius: 50%; width: 36rpx; height: 36rpx; font-size: 28rpx; color: white; background: #e7b85d; }
.limitation .limitation-item { display: flex; align-items: flex-start; gap: 18rpx; font-size: 24rpx; margin-top: 10rpx; }
.limitation-item > view:last-child { min-width: 0; flex: 1; }
.limitation-dot { width: 10rpx; height: 10rpx; margin-top: 17rpx; background: #e7b85d; border-radius: 50%; flex-shrink: 0; }
.personal-hint { margin-top: 24rpx; padding: 20rpx 0 24rpx; border-top: 1rpx solid #e7edeb; }
.personal-hint .muted { font-size: 25rpx; color: #68767b; }
.assistant .supplement-button { display: flex; align-items: center; justify-content: center; gap: 12rpx; width: 310rpx; box-sizing: border-box; max-width: 100%; margin: 20rpx auto 0; padding: 8rpx 28rpx; background: #eaf4ee; color: #1c5942; border-radius: 50rpx; font-size: 25rpx; font-weight: 600; line-height: 48rpx; }
.plus-icon { display: inline-flex; align-items: center; justify-content: center; flex: none; width: 28rpx; height: 28rpx; color: #fff; background: #519a77; border-radius: 50%; font-size: 27rpx; line-height: 28rpx; }
.assistant .disclosure { display: flex; align-items: center; justify-content: center; gap: 12rpx; width: 100%; margin: 0; padding: 18rpx 0; border-radius: 0; border-top: 1rpx solid #e7edeb; border-bottom: 1rpx solid #e7edeb; color: #235642; font-size: 24rpx; font-weight: 550; white-space: normal; }
.source { padding: 20rpx 0; border-bottom: 1rpx solid #edf0ea; overflow-wrap: anywhere; }
.saved { display: flex; align-items: center; gap: 12rpx; margin: 22rpx 0 18rpx; overflow-wrap: anywhere; }
.assistant .save-thought { display: flex; align-items: center; justify-content: center; gap: 16rpx; width: 100%; box-sizing: border-box; background: #eaf4ed; border-radius: 18rpx; color: #14513a; font-size: 26rpx; font-weight: 600; line-height: 72rpx; }
.save-thought .inline-icon { width: 30rpx; height: 30rpx; }
.follow-up > .label { font-size: 30rpx; font-weight: 650; margin: 0 0 20rpx; }
.suggestions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14rpx; margin-bottom: 20rpx; align-items: stretch; }
.suggestions button { width: 100%; height: 100%; min-width: 0; box-sizing: border-box; margin: 0; background: #eaf4ed; color: #205440; border: 1rpx solid #e5eee7; border-radius: 16rpx; font-size: 24rpx; font-weight: 400; line-height: 1.65; padding: 16rpx; text-align: left; white-space: normal; overflow-wrap: anywhere; }
.follow-up textarea, .note-editor textarea { background: #f5f8f3; border: 1rpx solid #dfe8de; border-radius: 16rpx; padding: 22rpx; font-size: 26rpx; line-height: 1.8; height: 180rpx; }
.follow-up .actions { flex-wrap: nowrap; gap: 16rpx; margin-top: 20rpx; }
.follow-up .actions button { min-width: 0; flex: 1; padding: 14rpx 8rpx; font-size: 25rpx; font-weight: 600; line-height: 1.8; border-radius: 16rpx; white-space: normal; }
.follow-up .secondary { background: #e8f2eb; color: #154d39; }
.follow-up button.primary { background: #216b50; }
.follow-up button.primary[disabled] { background: #f4f5f4; color: #a3aaa8; opacity: 1; }
.follow-up > .muted { margin-top: 18rpx; }
.note-editor { margin-top: 20rpx; }
.source-overlay { position: fixed; inset: 0; z-index: 20; background: rgba(0,0,0,.35); display: flex; align-items: flex-end; }
.conversation-page .source-sheet { width: 100%; box-sizing: border-box; margin: 0; padding-bottom: calc(30rpx + env(safe-area-inset-bottom)); }
.source-scroll { max-height: 65vh; height: 65vh; }
.technical { overflow-wrap: anywhere; white-space: pre-wrap; margin-top: 24rpx; }
