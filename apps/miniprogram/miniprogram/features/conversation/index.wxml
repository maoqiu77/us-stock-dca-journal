<view class="container conversation-page">
  <view class="row page-heading"><view class="title">{{title}}</view><button class="link" bindtap="more" aria-label="会话更多操作">•••</button></view>
  <view wx:if="{{label && !cloud}}" class="demo">{{label}}</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:for="{{turns}}" wx:key="id" id="message-{{item.id}}" class="turn {{focusMessage === item.id ? 'focused' : ''}}">
    <view class="question"><view class="muted">我的问题</view><view class="note">{{item.generatedQuestion ? item.questionTitle : item.question}}</view><button wx:if="{{item.generatedQuestion}}" class="link" data-id="{{item.id}}" data-field="questionOpen" bindtap="toggleTurn">{{item.questionOpen ? '收起分析条件' : '查看分析条件'}}</button><view wx:if="{{item.questionOpen}}" class="note">{{item.question}}</view></view>
    <view class="card assistant">
      <view class="row"><text class="badge">{{item.modelLabel}}</text><text class="muted">{{item.time}}</text></view>
      <view class="summary">{{item.summary}}</view>
      <view wx:for="{{item.metrics}}" wx:for-item="metric" wx:key="id" class="metric-block">
        <view class="label">{{metric.label}}</view><view class="metric-grid"><view wx:for="{{metric.rows}}" wx:for-item="cell" wx:key="label"><view class="muted">{{cell.label}}</view><view class="number">{{cell.value}}</view></view></view>
        <view class="muted">截至 {{metric.asOf}} · {{metric.adjustment}}</view><view class="muted">均线由本轮 K 线计算；区间高低点仅供观察，不代表已确认的支撑或压力。</view>
      </view>
      <view wx:if="{{item.evidence.length}}" class="section">判断依据</view><view wx:for="{{item.evidence}}" wx:for-item="evidence" wx:key="statement" class="note bullet">{{evidence.statement}}</view>
      <view wx:if="{{item.counterarguments.length}}" class="section">需要留意</view><view wx:for="{{item.counterarguments}}" wx:for-item="counter" wx:key="statement" class="note bullet">{{counter.statement}}</view>
      <view wx:if="{{item.conditions.length}}" class="section">后续观察</view><view wx:for="{{item.conditions}}" wx:for-item="condition" wx:key="text" class="note observation"><view class="badge observation-badge"><image class="inline-icon" src="{{condition.basis === 'user_assumption' ? '/assets/conversation/document.png' : '/assets/conversation/bars.png'}}" aria-hidden="true" /><text>{{condition.label}}</text></view><view>{{condition.text}}</view></view>
      <view wx:if="{{item.missing.length}}" class="limitation"><view class="label limitation-heading"><text class="warning-icon">!</text>分析范围</view><view wx:for="{{item.missing}}" wx:for-item="missing" wx:key="*this" class="note limitation-item"><view class="limitation-dot"/><view>{{missing}}</view></view></view>
      <view wx:if="{{item.personal.length}}" class="personal-hint"><view wx:for="{{item.personal}}" wx:for-item="personal" wx:key="*this" class="muted">{{personal}}</view><button class="link supplement-button" bindtap="supplement"><text class="plus-icon">+</text>补充持仓信息</button></view>
      <button wx:if="{{item.sources.length}}" class="link disclosure" data-id="{{item.id}}" data-field="expanded" bindtap="toggleTurn"><image class="inline-icon" src="/assets/conversation/database.png" aria-hidden="true" />{{item.expanded ? '收起数据与来源' : '数据与来源'}} · {{item.sources.length}} 项 {{item.expanded ? '⌃' : '⌄'}}</button>
      <view wx:if="{{item.expanded}}"><view wx:for="{{item.sources}}" wx:for-item="source" wx:key="id" class="source"><view class="label">{{source.label}}</view><view class="muted">{{source.detail}}</view><view class="muted">{{source.fetched}}</view><button class="link" data-id="{{source.id}}" bindtap="openSource">查看原始记录</button></view></view>
      <view class="saved muted"><image class="inline-icon" src="/assets/conversation/calendar.png" aria-hidden="true" />已保存至 {{item.savedDate}} 手记 · 本地</view><button class="link save-thought" data-id="{{item.id}}" bindtap="startSaveNote"><image class="inline-icon" src="/assets/conversation/edit.png" aria-hidden="true" />写下我的想法</button>
      <view wx:if="{{noteMessageId === item.id}}" class="note-editor"><view class="label">我的想法</view><textarea value="{{noteDraft}}" maxlength="10000" bindinput="onNoteDraft" placeholder="记录你的观察、判断或决定；不会自动发送给 AI"/><view class="actions"><button class="secondary" bindtap="cancelSaveNote">取消</button><button class="primary" bindtap="confirmSaveNote">保存想法</button></view></view>
    </view>
  </view>
  <view class="card follow-up" id="follow-up"><view class="label">继续追问</view><view class="suggestions"><button wx:for="{{nextQuestions}}" wx:key="*this" class="secondary small" data-question="{{item}}" bindtap="chooseQuestion">{{item}}</button></view><textarea value="{{question}}" focus="{{inputFocus}}" maxlength="10000" bindinput="onQuestion" placeholder="继续提问，或补充你的持仓信息"/><view class="actions"><button class="secondary" disabled="{{busy}}" bindtap="preview">预览发送内容</button><button wx:if="{{cloud}}" class="primary" loading="{{busy}}" disabled="{{busy || !previewData}}" bindtap="send">发送追问</button></view><view wx:if="{{previewData}}" class="muted">将使用 {{previewData.facts.length}} 项账本信息、{{previewData.excerpts.length}} 条原文及会话历史。<text wx:if="{{previewData.missingText}}">信息限制：{{previewData.missingText}}</text></view></view>
  <view wx:if="{{selectedSource}}" class="source-overlay"><view class="card source-sheet"><view class="row"><view class="symbol">原始记录</view><button class="link" bindtap="closeSource">关闭</button></view><scroll-view scroll-y class="source-scroll"><view class="note">{{selectedSource.content}}</view><view class="muted technical">观察时间 {{selectedSource.as_of}}\n获取时间 {{selectedSource.available_at}}\n校验标识 {{selectedSource.content_digest}}</view></scroll-view></view></view>
</view>

<welcome-dialog />
