<view class="container position-detail-page">
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <block wx:if="{{detail}}">
    <view class="page-header">
      <view><view class="title">{{detail.name || detail.symbol}}</view><view class="muted">{{detail.symbol}} · {{detail.currency || 'USD'}}</view></view>
      <view class="actions page-header-actions"><button wx:if="{{!detail.clockAnomaly && detail.currency === 'USD'}}" class="primary small" bindtap="addTrade">记一笔</button><button class="secondary small" bindtap="calibrate">校准</button></view>
    </view>
    <view wx:if="{{detail.clockAnomaly}}" class="error">设备时间异常；以下为截至 {{detail.throughDate}}、记录观察时点 {{detail.knownAt}} 的已保存持仓。校准后可继续记账，设置中仍可导出备份。</view>

    <view class="card position-summary">
      <view class="stats"><view class="stat"><view class="muted">持有数量</view><view class="number">{{detail.quantity}}</view></view><view class="stat"><view class="muted">剩余成本</view><view class="number">{{detail.costText}}</view></view></view>
      <view class="divider"/>
      <view class="row"><text>单位成本</text><text>{{detail.unitCostText}}</text></view>
      <view class="row"><text>持有金额<text wx:if="{{detail.amountFromScreenshot}}" class="data-origin"> · 截图</text></text><text>{{detail.holdingAmountText}}</text></view>
      <view class="row"><text>持有盈亏<text wx:if="{{detail.pnlFromScreenshot}}" class="data-origin"> · 截图</text></text><text class="number">{{detail.holdingPnlText}}{{detail.pnlPercent ? ' (' + detail.pnlPercent + ')' : ''}}</text></view>
      <view wx:if="{{detail.hasRealized}}" class="row"><text>已实现盈亏</text><text>{{detail.realizedText}}</text></view>
      <view wx:if="{{detail.market !== 'US' && detail.marketPrice}}" class="row reference-row"><text>{{detail.quoteFreshness === 'official_nav' ? '最新公布净值' : '参考价'}}</text><text>{{detail.marketPrice}}</text></view>
      <view wx:if="{{detail.market !== 'US' && detail.marketPrice && detail.quoteAsOf}}" class="muted position-source">{{detail.quoteFreshness === 'official_nav' ? '净值日' : '报价时间'}} {{detail.quoteAsOf}}</view>
      <view wx:if="{{detail.opening}}" class="note">含期初持仓：{{detail.opening.quantity}} 股，总成本 {{detail.opening.totalCost}}</view>
    </view>

    <view wx:if="{{detail.market === 'US' && detail.marketIdentity}}" class="position-market">
      <view class="section">{{detail.assetType === 'ETF' ? 'ETF 行情' : '股票行情'}}</view>
      <view class="card quote-panel"><view class="price {{quote.direction}}">{{quote.priceText || '--'}}</view><view class="change {{quote.direction}}">{{quote.changeAmountText || ''}}　{{quote.changeText || '--'}}</view><view wx:if="{{quoteTime}}" class="muted quote-meta">{{quote.sessionLabel ? quote.sessionLabel + ' · ' : ''}}{{quoteTime}} ET{{quoteSource ? ' · ' + quoteSource : ''}}</view></view>
      <view class="card chart-panel"><view class="chart-heading"><text>日 K</text><view class="ranges"><text wx:for="{{['1M','3M','1Y']}}" wx:key="*this" class="range {{range === item ? 'active' : ''}}" data-range="{{item}}" bindtap="changeRange">{{item === '1M' ? '1月' : item === '3M' ? '3月' : '1年'}}</text></view></view><view class="averages"><text wx:for="{{averages}}" wx:key="period" class="ma{{item.period}}">MA{{item.period}} {{item.value}}</text></view><view wx:if="{{chartLoading}}" class="empty-chart">加载日 K…</view><view wx:elif="{{chartError}}" class="empty-chart">{{chartError}}<button class="link" bindtap="loadMarketDetail">重试</button></view><block wx:else><market-chart bars="{{bars}}" style-mode="candle"/><view class="date-axis"><text>{{startDate}}</text><text>{{endDate}}</text></view><view class="muted chart-note">{{chartAdjustment}} · {{chartSource}} · {{chartAsOf}}</view></block></view>
      <view class="card"><view class="market-stats"><view wx:for="{{marketStats}}" wx:key="label"><view class="muted">{{item.label}}</view><view class="number">{{item.value}}</view></view></view></view>
    </view>

    <view wx:if="{{detail.screenshotMetrics}}" class="import-history"><button class="history-toggle" bindtap="toggleScreenshotDetails">导入时的截图记录 <text>{{showScreenshotDetails ? '收起' : '展开'}}</text></button><view wx:if="{{showScreenshotDetails}}" class="history-content"><view wx:if="{{detail.screenshotMetrics.marketValueText}}">持有金额：{{detail.screenshotMetrics.marketValueText}}</view><view wx:if="{{detail.screenshotMetrics.holdingPnlText}}">持有收益：{{detail.screenshotMetrics.holdingPnlText}}</view><view wx:if="{{detail.screenshotMetrics.holdingReturnRateText}}">持有收益率：{{detail.screenshotMetrics.holdingReturnRateText}}</view><view wx:if="{{detail.screenshotMetrics.dailyChangeRateText}}">日涨幅：{{detail.screenshotMetrics.dailyChangeRateText}}</view><view wx:if="{{detail.screenshotMetrics.navText}}">截图净值 / 参考价：{{detail.screenshotMetrics.navText}}</view><view wx:if="{{detail.screenshotMetrics.navDateText}}">截图净值日期：{{detail.screenshotMetrics.navDateText}}</view><view wx:for="{{detail.screenshotMetrics.originalFields}}" wx:key="index">{{item.label}}：{{item.value}} {{item.unit || ''}}</view><view wx:if="{{detail.screenshotMetrics.source}}"><view>来源：{{detail.screenshotMetrics.source.platform || '截图'}}</view><view wx:for="{{detail.screenshotMetrics.source.fields}}" wx:key="index">账户 · {{item.label}}：{{item.value}} {{item.unit || ''}}</view></view><view class="muted">导入时间：{{detail.screenshotImportedAt}}</view></view></view>

    <view class="section">相关记录与理由</view><view wx:for="{{detail.records}}" wx:key="revisionId" class="card"><view class="row"><text>{{item.date}} · {{item.label}}</text><text>{{item.quantity}} 股</text></view><view wx:if="{{item.note}}" class="note">{{item.note}}</view><view class="actions"><button wx:if="{{!item.voided && !detail.clockAnomaly}}" class="link" data-id="{{item.id}}" data-opening="{{item.isOpening}}" bindtap="editRecord">更正</button><button class="link" data-id="{{item.id}}" bindtap="showHistory">版本历史</button></view></view>
  </block>
</view>
<welcome-dialog />
