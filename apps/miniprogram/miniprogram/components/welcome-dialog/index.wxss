.welcome-mask { position: fixed; inset: 0; z-index: 9999; display: flex; align-items: center; justify-content: center; padding: 24px; box-sizing: border-box; background: rgba(0, 0, 0, .45); text-align: left; }
.welcome-dialog { width: 100%; max-width: 360px; max-height: 85vh; min-height: 0; display: flex; flex-direction: column; box-sizing: border-box; padding: 24px; border-radius: 18px; background: #fff; color: #263e33; text-align: left; }
.welcome-title { flex-shrink: 0; margin-bottom: 18px; font-size: 20px; font-weight: 600; line-height: 1.4; text-align: left; }
.welcome-content { min-height: 0; max-height: 58vh; font-size: 15px; line-height: 1.7; text-align: left; }
.welcome-section { font-weight: 600; margin-bottom: 4px; }
.welcome-line { overflow-wrap: break-word; }
.welcome-paragraph { margin: 12px 0 18px; color: #607068; }
.welcome-paragraph:last-child { margin-bottom: 0; }
.welcome-confirm { flex-shrink: 0; width: 100%; margin: 20px 0 0; padding: 12px 16px; border-radius: 10px; background: #17674d; color: #fff; font-size: 16px; line-height: 1.4; text-align: left; }
.welcome-confirm::after { border: 0; }
